[Unit]
Description=NSM masterlist service (v2: upvotes, fake players, feed, admin API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/opt/nsm-masterlist/masterlist.env
ExecStart=/opt/nsm-masterlist/nsm-masterlist --port 80 --state /var/lib/nsm-masterlist/state.json
Restart=always
RestartSec=3
# port 80 needs privileges
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
DynamicUser=yes
StateDirectory=nsm-masterlist
ReadWritePaths=/var/lib/nsm-masterlist
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
