# NSM Discord feed poller (copy to /opt/nsm-masterlist/poller.env)
# Bot setup: discord.com/developers/applications -> your app -> Bot ->
#   1. Reset Token, copy it below
#   2. Enable "Message Content Intent"
#   3. OAuth2 -> URL Generator -> scope: bot -> perms: View Channels +
#      Read Message History -> invite to your server
DISCORD_BOT_TOKEN=CHANGE-ME
DISCORD_CHANNEL_ID=1545984006196166736
MASTERLIST_ADMIN=http://127.0.0.1:80/admin
OWNER_TOKEN=CHANGE-ME-same-as-masterlist.env
POLL_INTERVAL=45
POLLER_STATE=/opt/nsm-masterlist/poller-state.json
