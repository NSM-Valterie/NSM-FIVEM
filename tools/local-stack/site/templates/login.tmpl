{{template "head" .}}
<section class="staff-panel-section" style="max-width:520px;margin:2.5rem auto 4rem;padding:0 1.25rem">
  <div class="fcard" style="padding:2rem">
    {{if .Require2FA}}
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:0.75rem">
        <span style="display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:10px;background:rgba(47,123,255,0.18);color:#5eead4;font-weight:800">2FA</span>
        <div>
          <h2 style="margin:0;font-size:1.35rem">Two-Step Verification</h2>
          <p class="muted" style="margin:2px 0 0;font-size:0.86rem">Enter the 6-digit security code for <strong>@{{.PrefillUser}}</strong></p>
        </div>
      </div>
      {{if .Error}}<div class="alert err" style="margin-bottom:1rem">{{.Error}}</div>{{end}}
      <form method="post" action="/login">
        <input type="hidden" name="username" value="{{.PrefillUser}}">
        <input type="hidden" name="password" value="{{.PendingPassword}}">
        <input type="hidden" name="next" value="{{.Next}}">
        <label class="flabel">6-Digit Two-Step Verification Code
          <input class="finput" name="totp_code" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autofocus placeholder="000000" style="font-size:1.35rem;letter-spacing:0.32em;text-align:center;font-weight:700">
        </label>
        <button class="btn primary" style="width:100%;justify-content:center;margin-top:1rem" type="submit">Verify &amp; Sign In</button>
      </form>
      <p class="muted" style="margin-top:1rem;text-align:center;font-size:0.85rem">
        <a href="/login">Back to Sign In</a>
      </p>
    {{else}}
      <h2 style="margin-bottom:.5rem">Sign In to NSM</h2>
      <p class="muted" style="margin-bottom:1.2rem;font-size:.9rem">Sign in to manage server keys in Keymaster, customize your profile, post on the AFX Forum, and link your NSM client.</p>
      {{if .Error}}<div class="alert err">{{.Error}}</div>{{end}}
      <form method="post" action="/login">
        <input type="hidden" name="next" value="{{.Next}}">
        <label class="flabel">Username or Email
          <input class="finput" name="username" value="{{.PrefillUser}}" required autofocus placeholder="nta~">
        </label>
        <label class="flabel">Password
          <input class="finput" type="password" name="password" required placeholder="••••••••">
        </label>
        <button class="btn primary" style="width:100%;justify-content:center;margin-top:1rem" type="submit">Sign In</button>
      </form>

      {{if .ShowOwnerSetup}}
      <div style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid rgba(255,255,255,.1)">
        <div style="font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#5eead4;margin-bottom:.4rem">One-Time Founder Setup (127.0.0.1)</div>
        <p class="muted" style="font-size:.82rem;margin-bottom:.75rem">Set the password for your <strong>nta~</strong> (Founder / Owner) account. Once set, this popup will not appear again.</p>
        <form method="post" action="/account/claim-owner" style="display:flex;gap:.5rem;flex-wrap:wrap">
          <input type="hidden" name="next" value="{{.Next}}">
          <input class="finput" type="password" name="password" required minlength="6" placeholder="Choose password for nta~ (6+ chars)" style="flex:1;min-width:180px;margin:0">
          <button class="btn" type="submit" style="background:rgba(47,123,255,.22);border:1px solid rgba(47,123,255,.5);color:#fff;font-weight:600">Set nta~ Password</button>
        </form>
      </div>
      {{end}}

      <p class="muted" style="margin-top:1.2rem;text-align:center;font-size:.9rem">
        No account yet? <a href="/register{{if .Next}}?next={{.Next}}{{end}}">Create one</a>
      </p>
    {{end}}
  </div>
</section>
{{template "foot" .}}
