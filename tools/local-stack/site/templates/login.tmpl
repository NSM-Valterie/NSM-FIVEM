{{template "head" .}}

<section class="wrap section auth-wrap">
  <div class="auth-card">
    <h1>Sign in to NSM</h1>
    <p class="muted">Use your NSM account for the website, community forum, Keymaster, and NSM desktop client.</p>
    {{if .Error}}<div class="alert alert-err" style="margin-bottom:12px">{{.Error}}</div>{{end}}
    <form method="post" action="/login" class="form">
      <input type="hidden" name="next" value="{{.Next}}">
      <label>Username
        <input type="text" name="username" class="inp" required autofocus>
      </label>
      <label>Password
        <input type="password" name="password" class="inp" required>
      </label>
      <button type="submit" class="btn btn-primary btn-block">Sign in</button>
    </form>
    <p class="auth-foot">No account yet? <a href="/register{{if .Next}}?next={{.Next}}{{end}}">Create one</a> &bull; <a href="/user-api-key/new">Sign in for NSM App</a></p>
  </div>
</section>

{{template "foot" .}}
