{{template "head" .}}
<section class="staff-panel-section" style="max-width:560px;margin:2.5rem auto 4rem;padding:0 1.25rem">
  <div class="fcard" style="padding:2rem">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:1rem">
      <div style="width:44px;height:44px;border-radius:12px;background:rgba(47,123,255,0.18);border:1px solid rgba(47,123,255,0.45);display:flex;align-items:center;justify-content:center;color:#60a5fa;font-size:1.3rem">✉️</div>
      <div>
        <h2 style="margin:0;font-size:1.4rem">Verify Your Email Address</h2>
        <p class="muted" style="margin:3px 0 0;font-size:0.88rem">Sent to <strong>{{.User.Email}}</strong> for account <strong>@{{.User.Username}}</strong></p>
      </div>
    </div>

    {{if .Msg}}<div class="alert" style="margin-bottom:1rem;padding:.75rem 1rem;border-radius:8px;background:rgba(16,185,129,.16);border:1px solid rgba(16,185,129,.45);color:#a7f3d0">{{.Msg}}</div>{{end}}
    {{if .Error}}<div class="alert err" style="margin-bottom:1rem">{{.Error}}</div>{{end}}

    {{if .User.EmailVerified}}
      <div style="padding:1.25rem;border-radius:10px;background:rgba(16,185,129,0.14);border:1px solid rgba(16,185,129,0.45);color:#a7f3d0;margin-bottom:1.25rem">
        <strong>✓ Email Verified:</strong> Your email address (<code>{{.User.Email}}</code>) is verified!
      </div>
      <a class="btn primary" href="{{if .Next}}{{.Next}}{{else}}/u/{{.User.Username}}{{end}}" style="width:100%;justify-content:center">Continue to Profile</a>
    {{else}}
      <p style="font-size:0.92rem;color:#cbd5e1;line-height:1.55;margin-bottom:1rem">
        We dispatched a 6-digit verification code to <strong>{{.User.Email}}</strong>. Enter the 6-digit code below to verify your email address and secure your AFX account.
      </p>

      {{if .User.EmailVerifyCode}}
      <div style="padding:12px 16px;border-radius:10px;background:rgba(47,123,255,0.14);border:1px dashed rgba(96,165,250,0.55);margin-bottom:1.25rem;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
        <div>
          <div style="font-size:0.74rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#93c5fd">Dispatched Verification Code ({{.User.Email}})</div>
          <div style="font-size:0.82rem;color:#cbd5e1;margin-top:2px">Use this 6-digit code to verify your email immediately:</div>
        </div>
        <code style="font-size:1.35rem;font-weight:800;letter-spacing:0.22em;padding:6px 14px;border-radius:8px;background:rgba(15,23,42,0.85);color:#5eead4;border:1px solid rgba(94,234,212,0.4)">{{.User.EmailVerifyCode}}</code>
      </div>
      {{end}}

      <form method="post" action="/account/verify-email">
        <input type="hidden" name="next" value="{{.Next}}">
        <label class="flabel">6-Digit Verification Code
          <input class="finput" name="code" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autofocus placeholder="000000" value="{{.User.EmailVerifyCode}}" style="font-size:1.35rem;letter-spacing:0.3em;text-align:center;font-weight:700">
        </label>
        <button class="btn primary" type="submit" style="width:100%;justify-content:center;margin-top:0.75rem">Verify Email Address</button>
      </form>

      <form method="post" action="/account/resend-verify" style="margin-top:1.25rem;padding-top:1rem;border-top:1px solid rgba(255,255,255,0.1);display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">
        <input type="hidden" name="next" value="{{.Next}}">
        <span class="muted" style="font-size:0.84rem">Didn't receive the email?</span>
        <button class="btn ghost sm" type="submit">Resend Verification Code</button>
      </form>

      <p class="muted" style="margin-top:1rem;text-align:center;font-size:0.84rem">
        <a href="{{if .Next}}{{.Next}}{{else}}/u/{{.User.Username}}{{end}}">Skip for now &rarr;</a>
      </p>
    {{end}}
  </div>
</section>
{{template "foot" .}}
