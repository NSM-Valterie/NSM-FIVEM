<!DOCTYPE html>
<html lang="en" class="discourse-dark-theme">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile - {{.Profile.EffectiveDisplayName}} (@{{.Profile.Username}}) - AFX Forum</title>
  <link rel="icon" type="image/png" href="/img/nsm-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=078h">
</head>
<body class="dc-ember-body user-summary-page">
  <!-- Discourse d-header -->
  <header class="d-header">
    <div class="d-header-wrap">
      <div class="d-header-left">
        <button type="button" class="btn-sidebar-toggle" onclick="document.getElementById('d-sidebar').classList.toggle('collapsed')" title="Toggle sidebar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <a href="/forum" class="d-logo-link">
          <img src="/img/nsm-icon.png" alt="NSM" class="d-logo-mark">
          <span class="d-logo-text">AFX <strong>Forum</strong></span>
        </a>
        <nav class="d-top-links">
          <a href="/">NSM.net</a>
          <a href="/servers">Server List</a>
          <a href="/keymaster">AFX Portal</a>
          <a href="/marketplace">Marketplace</a>
          <a href="/docs">Docs</a>
          <a href="/support">Support</a>
        </nav>
      </div>

      <div class="d-header-icons">
        <form method="get" action="/forum" class="d-header-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="search" name="q" placeholder="Search AFX Forum...">
        </form>

        {{if .User}}
        <a href="/u/{{.User.Username}}" class="d-header-user" title="{{.User.EffectiveDisplayName}} (@{{.User.Username}})">
          <img src="{{.User.AvatarPath}}" alt="{{.User.Username}}" class="d-header-avatar">
          <span class="d-header-username" id="live-navbar-display-name">{{.User.EffectiveDisplayName}}</span>
        </a>
        <a href="/u/{{.User.Username}}?tab=preferences" class="d-btn d-btn-flat">Preferences</a>
        <a href="/logout" class="d-btn d-btn-flat">Log Out</a>
        {{else}}
        <a href="/register?next=/u/{{.Profile.Username}}" class="d-btn d-btn-primary">Sign Up</a>
        <a href="/login?next=/u/{{.Profile.Username}}" class="d-btn d-btn-default">Log In</a>
        {{end}}
      </div>
    </div>
  </header>

  <div id="main-outlet-wrapper" class="d-outlet-wrapper">
    <!-- Left Discourse Sidebar -->
    <aside id="d-sidebar" class="sidebar-wrapper">
      <div class="sidebar-sections">
        <div class="sidebar-section">
          <ul class="sidebar-section-content">
            <li>
              <a href="/forum" class="sidebar-section-link">
                <span class="sidebar-section-link-prefix">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                </span>
                <span class="sidebar-section-link-content-text">Topics</span>
              </a>
            </li>
            <li>
              <a href="/forum?tab=categories" class="sidebar-section-link">
                <span class="sidebar-section-link-prefix">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                </span>
                <span class="sidebar-section-link-content-text">Categories</span>
              </a>
            </li>
            <li>
              <a href="/u" class="sidebar-section-link">
                <span class="sidebar-section-link-prefix">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </span>
                <span class="sidebar-section-link-content-text">Users</span>
              </a>
            </li>
            <li>
              <a href="/u/{{.Profile.Username}}" class="sidebar-section-link active">
                <span class="sidebar-section-link-prefix">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </span>
                <span class="sidebar-section-link-content-text">{{.Profile.EffectiveDisplayName}}</span>
              </a>
            </li>
          </ul>
        </div>

        <div class="sidebar-section">
          <div class="sidebar-section-header">CATEGORIES</div>
          <ul class="sidebar-section-content">
            {{range .Categories}}
            <li>
              <a href="/forum/c/{{.Slug}}" class="sidebar-section-link">
                <span class="sidebar-section-link-prefix">
                  <span class="prefix-square" style="background:{{.Color}}"></span>
                </span>
                <span class="sidebar-section-link-content-text">{{.Name}}</span>
                <span class="sidebar-section-link-suffix">{{.TopicCount}}</span>
              </a>
            </li>
            {{end}}
          </ul>
        </div>
      </div>
    </aside>

    <!-- Main Discourse User Profile Outlet (1:1 discourse/app/templates/user.gjs + Discord Profile Theme Layout) -->
    <main id="main-outlet" class="d-main-outlet">
      {{if .Msg}}
      <div class="d-alert d-alert-success">{{.Msg}}</div>
      {{end}}
      {{if .Error}}
      <div class="d-alert d-alert-error">{{.Error}}</div>
      {{end}}

      <div class="container {{if .IsOwn}}viewing-self{{end}}">
        <section
          class="user-main user-themed-profile"
          id="nsm-user-profile-root"
          style="{{.Profile.ThemeStyleAttr}}"
        >
          <!-- section.about.has-background -->
          <section class="about has-background">
            <div
              class="user-profile-image"
              id="live-profile-banner"
              style="{{.Profile.BannerStyleAttr}}"
            >
              <div class="user-profile-banner-shine"></div>
            </div>

            <div class="details">
              <div class="primary">
                <!-- UserProfileAvatar -->
                <div class="user-profile-avatar">
                  <img alt="{{.Profile.EffectiveDisplayName}}" width="120" height="120" src="{{.Profile.AvatarPath}}" class="avatar" id="live-profile-avatar">
                  {{if or (eq .Profile.Role "owner") (eq .Profile.Role "admin") (eq .Profile.Role "staff")}}
                  <div class="avatar-flair" title="AFX Platform Staff">&#9733;</div>
                  {{end}}
                </div>

                <!-- .primary-textual -->
                <div class="primary-textual">
                  <div class="user-profile-names">
                    <div class="username user-profile-names__primary">
                      <span id="live-profile-display-name">{{.Profile.EffectiveDisplayName}}</span>
                      {{if or (eq .Profile.Role "owner") (eq .Profile.Role "admin") (eq .Profile.Role "staff")}}
                      <svg class="d-icon" viewBox="0 0 24 24" fill="currentColor" style="width:18px;height:18px;color:var(--prof-primary)" title="Moderator / Owner"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
                      {{end}}
                    </div>
                    <div class="full-name user-profile-names__secondary" id="live-profile-handle">@{{.Profile.Username}}</div>
                    <div class="user-profile-names__title">
                      <span id="live-profile-title">{{.Profile.EffectiveTitle}}</span>
                      <span class="d-role-tag role-{{.Profile.Role}}">{{.Profile.Role}}</span>
                    </div>
                  </div>

                  <div class="bio" id="live-profile-bio">
                    {{if .Profile.Bio}}
                    <p>{{.Profile.Bio}}</p>
                    {{else}}
                    <p>NSM &amp; AFX Platform Member. Playing on customized Grand Theft Auto V dedicated servers.</p>
                    {{end}}
                  </div>

                  <!-- Location, Website, Discord, GitHub, Steam, YouTube, Twitch, X/Twitter, Favorite Server -->
                  <div class="location-and-website user-profile__location-and-website">
                    {{if .Profile.Location}}
                    <div class="user-profile-location">
                      <svg class="d-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                      <span>{{.Profile.Location}}</span>
                    </div>
                    {{end}}

                    {{if .Profile.DiscordTag}}
                    <div class="d-social-pill d-social-discord" title="Discord">
                      <svg class="d-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
                      <span>{{.Profile.DiscordTag}}</span>
                    </div>
                    {{end}}

                    {{if .Profile.GitHub}}
                    <a href="{{.Profile.GitHubURL}}" class="d-social-pill d-social-github" rel="noopener" title="GitHub">
                      <svg class="d-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                      <span>github.com/{{.Profile.GitHubHandle}}</span>
                    </a>
                    {{end}}

                    {{if .Profile.Steam}}
                    <a href="{{.Profile.SteamURL}}" class="d-social-pill d-social-steam" rel="noopener" title="Steam">
                      <svg class="d-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0z"/></svg>
                      <span>{{.Profile.Steam}}</span>
                    </a>
                    {{end}}

                    {{if .Profile.YouTube}}
                    <a href="{{.Profile.YouTubeURL}}" class="d-social-pill d-social-youtube" rel="noopener" title="YouTube">
                      <svg class="d-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                      <span>{{.Profile.YouTube}}</span>
                    </a>
                    {{end}}

                    {{if .Profile.Twitch}}
                    <a href="{{.Profile.TwitchURL}}" class="d-social-pill d-social-twitch" rel="noopener" title="Twitch">
                      <svg class="d-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z"/></svg>
                      <span>{{.Profile.Twitch}}</span>
                    </a>
                    {{end}}

                    {{if .Profile.Twitter}}
                    <a href="{{.Profile.TwitterURL}}" class="d-social-pill d-social-twitter" rel="noopener" title="X / Twitter">
                      <svg class="d-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                      <span>{{.Profile.Twitter}}</span>
                    </a>
                    {{end}}

                    {{if .Profile.Website}}
                    <a href="{{.Profile.Website}}" class="d-social-pill" rel="noopener" title="Website">
                      <svg class="d-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                      <span>{{.Profile.Website}}</span>
                    </a>
                    {{end}}

                    {{if .Profile.FavoriteServer}}
                    <div class="d-social-pill">
                      <svg class="d-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                      <span>Server: <strong>{{.Profile.FavoriteServer}}</strong></span>
                    </div>
                    {{end}}
                  </div>
                </div>

                <!-- .controls -->
                <section class="controls">
                  <ul>
                    {{if .IsOwn}}
                    <li>
                      <a href="/u/{{.Profile.Username}}?tab=preferences" class="d-btn d-btn-primary d-btn-theme">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                        <span>Edit Profile &amp; Colors</span>
                      </a>
                    </li>
                    <li>
                      <a href="/user-api-key/new" class="d-btn d-btn-default">
                        <span>Link NSM.exe</span>
                      </a>
                    </li>
                    {{else}}
                    <li>
                      <a href="/u/{{.Profile.Username}}?tab=messages" class="d-btn d-btn-primary d-btn-theme">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        <span>Message</span>
                      </a>
                    </li>
                    {{end}}
                    <li>
                      <a href="/keymaster" class="d-btn d-btn-default">
                        <span>AFX Portal</span>
                      </a>
                    </li>
                  </ul>
                </section>
              </div>

              <!-- Discourse #collapsed-info-panel (user/collapsed-info.gjs) -->
              <div class="secondary" id="collapsed-info-panel">
                <dl>
                  <div>
                    <dt class="created-at">Joined</dt>
                    <dd class="created-at">{{.JoinedStr}}</dd>
                  </div>
                  <div>
                    <dt class="last-posted-at">Last Post</dt>
                    <dd class="last-posted-at">{{.LastPostStr}}</dd>
                  </div>
                  <div>
                    <dt class="last-seen-at">Seen</dt>
                    <dd class="last-seen-at">{{.LastSeenStr}}</dd>
                  </div>
                  <div>
                    <dt class="profile-view-count">Views</dt>
                    <dd class="profile-view-count">{{.ProfileViews}}</dd>
                  </div>
                  <div>
                    <dt class="trust-level">Trust Level</dt>
                    <dd class="trust-level">{{.TrustLevelName}}</dd>
                  </div>
                  <div>
                    <dt class="groups">Groups</dt>
                    <dd class="groups">
                      <span><a href="/u" class="group-link">{{.Profile.Role}}</a></span>
                      <span><a href="/u" class="group-link">afx_verified</a></span>
                    </dd>
                  </div>
                </dl>
              </div>
            </div>
          </section>

          <!-- Discourse .user-content-wrapper (1:1 Primary Navigation Bar) -->
          <div class="user-content-wrapper">
            <div class="user-primary-navigation">
              <ul class="nav-pills user-nav">
                <li>
                  <a href="/u/{{.Profile.Username}}?tab=summary" class="{{if eq .Tab "summary"}}active{{end}}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    <span>Summary</span>
                  </a>
                </li>
                <li>
                  <a href="/u/{{.Profile.Username}}?tab=activity" class="{{if .IsActivityTab}}active{{end}}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                    <span>Activity</span>
                  </a>
                </li>
                <li>
                  <a href="/u/{{.Profile.Username}}?tab=notifications" class="{{if eq .Tab "notifications"}}active{{end}}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                    <span>Notifications ({{len .Notifications}})</span>
                  </a>
                </li>
                <li>
                  <a href="/u/{{.Profile.Username}}?tab=messages" class="{{if eq .Tab "messages"}}active{{end}}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    <span>Messages ({{len .Messages}})</span>
                  </a>
                </li>
                <li>
                  <a href="/u/{{.Profile.Username}}?tab=badges" class="{{if eq .Tab "badges"}}active{{end}}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
                    <span>Badges ({{len .Badges}})</span>
                  </a>
                </li>
                {{if .IsOwn}}
                <li>
                  <a href="/u/{{.Profile.Username}}?tab=preferences" class="{{if eq .Tab "preferences"}}active{{end}}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9"/></svg>
                    <span>Preferences</span>
                  </a>
                </li>
                {{end}}
              </ul>
            </div>

            <!-- Discourse #user-content -->
            <div class="user-content" id="user-content">

              {{if eq .Tab "preferences"}}
              <!-- ==============================================================
                   TAB: PREFERENCES & DISCORD-STYLE PROFILE THEME CUSTOMIZER
                   ============================================================== -->
              {{if .IsOwn}}
              <div class="d-preferences-grid">
                <div class="d-pref-card">
                  <form method="post" action="/account/profile" enctype="multipart/form-data" class="d-pref-form" id="nsm-profile-form">
                    <input type="hidden" name="return_tab" value="preferences">

                    <div class="d-pref-header-bar">
                      <div>
                        <h3 class="stats-title" style="margin-bottom:4px">Account Identity &amp; Discord-Style Profile Theme</h3>
                        <p class="d-muted" style="font-size:13px;margin:0">Changes to your Display Name and Profile Layout Colors update your profile immediately across NSM &amp; AFX Forum.</p>
                      </div>
                      <button type="submit" class="d-btn d-btn-primary d-btn-theme">Save Changes</button>
                    </div>

                    <!-- 1. DISPLAY NAME & @USERNAME -->
                    <div class="d-form-row-3" style="margin-top:14px">
                      <label class="d-label">
                        <span>Display Name (Shown on Profile, Navbar &amp; Posts)</span>
                        <input
                          type="text"
                          name="display_name"
                          id="input-display-name"
                          value="{{.Profile.EffectiveDisplayName}}"
                          class="d-input"
                          maxlength="48"
                          placeholder="Your display name"
                          oninput="var el=document.getElementById('live-profile-display-name');if(el)el.textContent=this.value||'{{.Profile.Username}}';var nav=document.getElementById('live-navbar-display-name');if(nav)nav.textContent=this.value||'{{.Profile.Username}}';"
                        >
                      </label>
                      <label class="d-label">
                        <span>Username (@handle)</span>
                        <input
                          type="text"
                          name="new_username"
                          id="input-new-username"
                          value="{{.Profile.Username}}"
                          class="d-input"
                          maxlength="32"
                          placeholder="username"
                          oninput="var h=document.getElementById('live-profile-handle');if(h)h.textContent='@'+(this.value||'{{.Profile.Username}}');"
                        >
                      </label>
                      <label class="d-label">
                        <span>Custom Title / Role Subtitle</span>
                        <input
                          type="text"
                          name="title"
                          value="{{.Profile.Title}}"
                          class="d-input"
                          maxlength="64"
                          placeholder="e.g. Server Developer, Roleplay Creator"
                          oninput="var t=document.getElementById('live-profile-title');if(t)t.textContent=this.value||'{{.Profile.EffectiveTitle}}';"
                        >
                      </label>
                    </div>

                    <!-- 2. DISCORD-STYLE PROFILE THEME & LAYOUT COLORS -->
                    <div class="d-discord-theme-box">
                      <div class="d-discord-theme-header">
                        <div>
                          <h4 class="d-sub-heading" style="margin:0;border:none;padding:0">Discord-Style Profile Layout Colors</h4>
                          <p class="d-muted" style="font-size:12.5px;margin:4px 0 0">Choose a preset or pick custom Primary &amp; Accent colors to theme your entire profile card, header gradient, borders, and badges.</p>
                        </div>
                        <span class="d-theme-live-pill">Live Preview Active</span>
                      </div>

                      <!-- Preset Swatches -->
                      <div class="d-theme-presets-grid">
                        {{range .ThemePresets}}
                        <button
                          type="button"
                          class="d-theme-preset-btn"
                          onclick="applyNsmProfileTheme('{{.Primary}}','{{.Accent}}','{{.Banner}}','{{.Avatar}}')"
                          title="Apply {{.Name}} Theme"
                        >
                          <span class="d-theme-preset-swatch" style="{{.SwatchStyle}}"></span>
                          <span class="d-theme-preset-name">{{.Name}}</span>
                        </button>
                        {{end}}
                      </div>

                      <!-- 4 Color Pickers (Primary Layout, Accent Gradient, Banner, Monogram Avatar) -->
                      <div class="d-form-row-4" style="margin-top:14px">
                        <label class="d-label d-color-picker-label">
                          <span>Primary Layout Color</span>
                          <div class="d-color-input-wrap">
                            <input
                              type="color"
                              name="theme_primary"
                              id="picker-theme-primary"
                              value="{{.Profile.EffectiveThemePrimary}}"
                              class="d-color-input"
                              oninput="syncNsmLiveColors()"
                            >
                            <code id="hex-theme-primary">{{.Profile.EffectiveThemePrimary}}</code>
                          </div>
                        </label>

                        <label class="d-label d-color-picker-label">
                          <span>Accent / Gradient Color</span>
                          <div class="d-color-input-wrap">
                            <input
                              type="color"
                              name="theme_accent"
                              id="picker-theme-accent"
                              value="{{.Profile.EffectiveThemeAccent}}"
                              class="d-color-input"
                              oninput="syncNsmLiveColors()"
                            >
                            <code id="hex-theme-accent">{{.Profile.EffectiveThemeAccent}}</code>
                          </div>
                        </label>

                        <label class="d-label d-color-picker-label">
                          <span>Header Banner Color</span>
                          <div class="d-color-input-wrap">
                            <input
                              type="color"
                              name="banner_color"
                              id="picker-banner-color"
                              value="{{.Profile.EffectiveBannerColor}}"
                              class="d-color-input"
                              oninput="syncNsmLiveColors()"
                            >
                            <code id="hex-banner-color">{{.Profile.EffectiveBannerColor}}</code>
                          </div>
                        </label>

                        <label class="d-label d-color-picker-label">
                          <span>Avatar Ring &amp; Monogram</span>
                          <div class="d-color-input-wrap">
                            <input
                              type="color"
                              name="avatar_color"
                              id="picker-avatar-color"
                              value="{{.Profile.EffectiveAvatarColor}}"
                              class="d-color-input"
                              oninput="syncNsmLiveColors()"
                            >
                            <code id="hex-avatar-color">{{.Profile.EffectiveAvatarColor}}</code>
                          </div>
                        </label>
                      </div>
                    </div>

                    <label class="d-label">
                      <span>Bio / About Me</span>
                      <textarea name="bio" class="d-input d-textarea" rows="3" maxlength="600" placeholder="Tell the NSM &amp; AFX community about yourself, your servers, or your resources...">{{.Profile.Bio}}</textarea>
                    </label>

                    <label class="d-label">
                      <span>Forum Post Signature / Status Line</span>
                      <input type="text" name="signature" value="{{.Profile.Signature}}" class="d-input" maxlength="200" placeholder="Appears beneath your posts on AFX Forum">
                    </label>

                    <h4 class="d-sub-heading">Connected Social &amp; Developer Accounts</h4>
                    <div class="d-form-row-2">
                      <label class="d-label">
                        <span>Discord Username / Tag</span>
                        <input type="text" name="discord_tag" value="{{.Profile.DiscordTag}}" class="d-input" maxlength="64" placeholder="e.g. cravenz or discord.gg/yourserver">
                      </label>
                      <label class="d-label">
                        <span>GitHub Username or URL</span>
                        <input type="text" name="github" value="{{.Profile.GitHub}}" class="d-input" maxlength="120" placeholder="e.g. platinum-cfx or https://github.com/username">
                      </label>
                    </div>

                    <div class="d-form-row-3">
                      <label class="d-label">
                        <span>Steam Username or Profile URL</span>
                        <input type="text" name="steam" value="{{.Profile.Steam}}" class="d-input" maxlength="120" placeholder="e.g. cravenz">
                      </label>
                      <label class="d-label">
                        <span>YouTube Channel / @Handle</span>
                        <input type="text" name="youtube" value="{{.Profile.YouTube}}" class="d-input" maxlength="120" placeholder="e.g. @cravenz">
                      </label>
                      <label class="d-label">
                        <span>Twitch Channel</span>
                        <input type="text" name="twitch" value="{{.Profile.Twitch}}" class="d-input" maxlength="120" placeholder="e.g. cravenz">
                      </label>
                    </div>

                    <div class="d-form-row-3">
                      <label class="d-label">
                        <span>X / Twitter Handle</span>
                        <input type="text" name="twitter" value="{{.Profile.Twitter}}" class="d-input" maxlength="80" placeholder="e.g. @cravenz">
                      </label>
                      <label class="d-label">
                        <span>Website / Tebex Store URL</span>
                        <input type="url" name="website" value="{{.Profile.Website}}" class="d-input" maxlength="160" placeholder="https://...">
                      </label>
                      <label class="d-label">
                        <span>Location</span>
                        <input type="text" name="location" value="{{.Profile.Location}}" class="d-input" maxlength="64" placeholder="e.g. Miami, FL">
                      </label>
                    </div>

                    <div class="d-form-row-2">
                      <label class="d-label">
                        <span>Favorite / Owned NSM Server</span>
                        <input type="text" name="favorite_server" value="{{.Profile.FavoriteServer}}" class="d-input" maxlength="80" placeholder="e.g. NSM Official Server">
                      </label>
                      <label class="d-label">
                        <span>Email Address</span>
                        <input type="email" name="email" value="{{.Profile.Email}}" class="d-input" maxlength="120" placeholder="you@example.com">
                      </label>
                    </div>

                    <h4 class="d-sub-heading">Avatar &amp; Custom Banner Image</h4>
                    <div class="d-form-row-3">
                      <label class="d-label">
                        <span>Upload Custom Avatar Image</span>
                        <input type="file" name="avatar_file" accept="image/png,image/jpeg,image/gif,image/webp" class="d-input">
                      </label>
                      <label class="d-label">
                        <span>Or External Avatar Image URL</span>
                        <input type="url" name="avatar_url" value="{{.Profile.AvatarURL}}" class="d-input" placeholder="https://example.com/avatar.png">
                      </label>
                      <label class="d-label">
                        <span>Custom Banner Image URL</span>
                        <input type="url" name="banner_url" value="{{.Profile.BannerURL}}" class="d-input" placeholder="https://example.com/banner.jpg">
                      </label>
                    </div>

                    {{if or .Profile.AvatarData .Profile.AvatarURL}}
                    <label class="d-checkbox-row">
                      <input type="checkbox" name="clear_avatar" value="1">
                      <span>Reset custom avatar back to generated NSM monogram avatar</span>
                    </label>
                    {{end}}

                    <div style="margin-top:16px;display:flex;gap:10px;align-items:center">
                      <button type="submit" class="d-btn d-btn-primary d-btn-theme">Save Profile &amp; Theme Changes</button>
                      <a href="/u/{{.Profile.Username}}?tab=summary" class="d-btn d-btn-default">View Summary</a>
                    </div>
                  </form>
                </div>

                <!-- Right Column: NSM Desktop Client Link & Password Security -->
                <div class="d-pref-side">
                  <div class="d-pref-card">
                    <h3 class="stats-title">NSM.exe Desktop Client Link</h3>
                    <p class="d-muted" style="margin-bottom:12px">
                      Push your active account session directly into the NSM desktop client, or open the Client Authorization screen:
                    </p>
                    <div style="display:flex;flex-direction:column;gap:8px">
                      <form method="post" action="/account/connect-client">
                        <button type="submit" class="d-btn d-btn-primary d-btn-theme" style="width:100%">Authorize Waiting NSM.exe Client</button>
                      </form>
                      <a href="/user-api-key/new" class="d-btn d-btn-default">Open Client Auth Page</a>
                      <a href="/keymaster" class="d-btn d-btn-default">Manage Server Keys (AFX Portal)</a>
                    </div>
                  </div>

                  <div class="d-pref-card" style="margin-top:18px">
                    <h3 class="stats-title">Account Security &amp; Password</h3>
                    <form method="post" action="/account/password" class="d-pref-form">
                      <label class="d-label">
                        <span>Current Password</span>
                        <input type="password" name="old" class="d-input" required>
                      </label>
                      <label class="d-label">
                        <span>New Password (6+ characters)</span>
                        <input type="password" name="new" class="d-input" required minlength="6">
                      </label>
                      <button type="submit" class="d-btn d-btn-default" style="margin-top:8px">Update Password</button>
                    </form>
                  </div>
                </div>
              </div>
              {{else}}
              <div class="top-section">
                <h3 class="stats-title">Profile Preferences</h3>
                <p class="d-muted">Sign in as <strong>@{{.Profile.Username}}</strong> to edit profile settings and layout theme colors.</p>
              </div>
              {{end}}

              {{else if .IsActivityTab}}
              <!-- ==============================================================
                   TAB: ACTIVITY (1:1 forum.cfx.re/u/<username>/activity with
                   Left .user-secondary-navigation + Right Stream / Topic Table)
                   ============================================================== -->
              <div class="d-activity-layout">
                <!-- Left Secondary Vertical Navigation (1:1 Discourse user-secondary-navigation) -->
                <div class="user-navigation user-secondary-navigation">
                  <nav class="user-nav-secondary">
                    <ul class="action-list nav-stacked">
                      <li>
                        <a href="/u/{{.Profile.Username}}?tab=activity" class="{{if eq .ActivitySub "all"}}active{{end}}">
                          <span>All</span>
                          <span class="d-subnav-count">{{len .Posts}}</span>
                        </a>
                      </li>
                      <li>
                        <a href="/u/{{.Profile.Username}}?tab=topics" class="{{if eq .ActivitySub "topics"}}active{{end}}">
                          <span>Topics</span>
                          <span class="d-subnav-count">{{.TopicCount}}</span>
                        </a>
                      </li>
                      <li>
                        <a href="/u/{{.Profile.Username}}?tab=replies" class="{{if eq .ActivitySub "replies"}}active{{end}}">
                          <span>Replies</span>
                          <span class="d-subnav-count">{{.ReplyCount}}</span>
                        </a>
                      </li>
                      <li>
                        <a href="/u/{{.Profile.Username}}?tab=read" class="{{if eq .ActivitySub "read"}}active{{end}}">
                          <span>Read</span>
                          <span class="d-subnav-count">{{len .ReadTopics}}</span>
                        </a>
                      </li>
                      <li>
                        <a href="/u/{{.Profile.Username}}?tab=likes" class="{{if eq .ActivitySub "likes"}}active{{end}}">
                          <span>Likes</span>
                          <span class="d-subnav-count">{{.LikedCount}}</span>
                        </a>
                      </li>
                      <li>
                        <a href="/u/{{.Profile.Username}}?tab=solved" class="{{if eq .ActivitySub "solved"}}active{{end}}">
                          <span>Solved</span>
                          <span class="d-subnav-count">{{.SolvedCount}}</span>
                        </a>
                      </li>
                      <li>
                        <a href="/u/{{.Profile.Username}}?tab=votes" class="{{if eq .ActivitySub "votes"}}active{{end}}">
                          <span>Votes</span>
                          <span class="d-subnav-count">{{.UpvoteCount}}</span>
                        </a>
                      </li>
                    </ul>
                  </nav>
                </div>

                <!-- Right Main Activity Content Stream -->
                <div class="user-content-stream">

                  {{if eq .ActivitySub "topics"}}
                  <!-- SUB-TAB: TOPICS CREATED BY USER (Discourse table.topic-list) -->
                  <div class="d-stream-header">
                    <h3 class="stats-title" style="margin:0">Topics Created by {{.Profile.EffectiveDisplayName}} ({{.TopicCount}})</h3>
                    <a href="/forum" class="d-btn d-btn-primary d-btn-theme d-btn-xs">+ New Topic</a>
                  </div>
                  {{if .EnrichedTopics}}
                  <table class="topic-list d-profile-topic-list">
                    <thead class="topic-list-header">
                      <tr>
                        <th class="default topic-list-data">Topic</th>
                        <th class="num posts-map topic-list-data">Replies</th>
                        <th class="num views topic-list-data">Views</th>
                        <th class="num activity topic-list-data">Activity</th>
                      </tr>
                    </thead>
                    <tbody class="topic-list-body">
                      {{range .EnrichedTopics}}
                      <tr class="topic-list-item">
                        <td class="main-link clearfix topic-list-data">
                          <span class="link-top-line">
                            <a href="/forum/t/{{.ID}}" class="title raw-link raw-topic-link">{{.Title}}</a>
                          </span>
                          <div class="link-bottom-line">
                            <a class="badge-category__wrapper" href="/forum/c/{{.CategorySlug}}">
                              <span class="badge-category-bg" style="background-color: {{.CategoryColor}}"></span>
                              <span class="badge-category__name">{{.CategoryName}}</span>
                            </a>
                            {{if .Tags}}
                            <div class="discourse-tags">
                              {{range .Tags}}<span class="discourse-tag box">{{.}}</span>{{end}}
                            </div>
                            {{end}}
                          </div>
                        </td>
                        <td class="num posts-map posts topic-list-data"><span class="number">{{.Replies}}</span></td>
                        <td class="num views topic-list-data"><span class="number">{{.Views}}</span></td>
                        <td class="num age activity topic-list-data"><span class="relative-date">{{.LastActiveStr}}</span></td>
                      </tr>
                      {{end}}
                    </tbody>
                  </table>
                  {{else}}
                  <div class="d-empty-stream">
                    <p>No topics created by <strong>{{.Profile.EffectiveDisplayName}}</strong> yet.</p>
                    <a href="/forum" class="d-btn d-btn-primary d-btn-theme">Create First Topic on AFX Forum</a>
                  </div>
                  {{end}}

                  {{else if eq .ActivitySub "replies"}}
                  <!-- SUB-TAB: REPLIES POSTED BY USER -->
                  <div class="d-stream-header">
                    <h3 class="stats-title" style="margin:0">Replies by {{.Profile.EffectiveDisplayName}} ({{.ReplyCount}})</h3>
                  </div>
                  {{if .ReplyPosts}}
                  <div class="user-stream">
                    {{range .ReplyPosts}}
                    <div class="user-stream-item item">
                      <div class="user-stream-item-header">
                        <a href="/u/{{$.Profile.Username}}" class="stream-avatar-link">
                          <img src="{{$.Profile.AvatarPath}}" alt="{{$.Profile.EffectiveDisplayName}}" width="40" height="40" class="avatar">
                        </a>
                        <div class="stream-topic-meta">
                          <div class="stream-topic-title-line">
                            <a href="/forum/t/{{.TopicID}}#post-{{.PostNumber}}" class="stream-topic-title">{{.TopicTitle}}</a>
                            <span class="stream-post-badge">Reply #{{.PostNumber}}</span>
                          </div>
                          <div class="stream-category-line">
                            <a class="badge-category__wrapper" href="/forum/c/{{.CategorySlug}}">
                              <span class="badge-category-bg" style="background-color: {{.CategoryColor}}"></span>
                              <span class="badge-category__name">{{.CategoryName}}</span>
                            </a>
                            {{range .Tags}}<span class="discourse-tag box">{{.}}</span>{{end}}
                          </div>
                        </div>
                        <div class="stream-time-meta">
                          <span class="time" title="{{.CreatedAt}}">{{.RelativeStr}}</span>
                          {{if gt .Likes 0}}<span class="stream-likes"><span class="d-icon-heart">&#10084;</span> {{.Likes}}</span>{{end}}
                        </div>
                      </div>
                      <div class="excerpt">
                        {{range .Paragraphs}}<p>{{.}}</p>{{end}}
                      </div>
                    </div>
                    {{end}}
                  </div>
                  {{else}}
                  <div class="d-empty-stream">
                    <p>No replies posted by <strong>{{.Profile.EffectiveDisplayName}}</strong> yet.</p>
                    <a href="/forum" class="d-btn d-btn-default">Browse Active Forum Discussions</a>
                  </div>
                  {{end}}

                  {{else if eq .ActivitySub "read"}}
                  <!-- SUB-TAB: READ TOPICS -->
                  <div class="d-stream-header">
                    <h3 class="stats-title" style="margin:0">Recently Read Topics ({{len .ReadTopics}})</h3>
                  </div>
                  <table class="topic-list d-profile-topic-list">
                    <thead class="topic-list-header">
                      <tr>
                        <th class="default topic-list-data">Topic</th>
                        <th class="num posts-map topic-list-data">Replies</th>
                        <th class="num views topic-list-data">Views</th>
                        <th class="num activity topic-list-data">Last Read</th>
                      </tr>
                    </thead>
                    <tbody class="topic-list-body">
                      {{range .ReadTopics}}
                      <tr class="topic-list-item">
                        <td class="main-link clearfix topic-list-data">
                          <span class="link-top-line">
                            <a href="/forum/t/{{.ID}}" class="title raw-link raw-topic-link">{{.Title}}</a>
                          </span>
                          <div class="link-bottom-line">
                            <a class="badge-category__wrapper" href="/forum/c/{{.CategorySlug}}">
                              <span class="badge-category-bg" style="background-color: {{.CategoryColor}}"></span>
                              <span class="badge-category__name">{{.CategoryName}}</span>
                            </a>
                            {{if .Tags}}
                            <div class="discourse-tags">
                              {{range .Tags}}<span class="discourse-tag box">{{.}}</span>{{end}}
                            </div>
                            {{end}}
                          </div>
                        </td>
                        <td class="num posts-map posts topic-list-data"><span class="number">{{.Replies}}</span></td>
                        <td class="num views topic-list-data"><span class="number">{{.Views}}</span></td>
                        <td class="num age activity topic-list-data"><span class="relative-date">{{.LastActiveStr}}</span></td>
                      </tr>
                      {{end}}
                    </tbody>
                  </table>

                  {{else if eq .ActivitySub "likes"}}
                  <!-- SUB-TAB: LIKES GIVEN & RECEIVED -->
                  <div class="d-stream-header">
                    <h3 class="stats-title" style="margin:0">Liked Posts &amp; Appreciated Contributions ({{.LikedCount}})</h3>
                  </div>
                  {{if .LikedPosts}}
                  <div class="user-stream">
                    {{range .LikedPosts}}
                    <div class="user-stream-item item">
                      <div class="user-stream-item-header">
                        <a href="/u/{{$.Profile.Username}}" class="stream-avatar-link">
                          <img src="{{$.Profile.AvatarPath}}" alt="{{$.Profile.EffectiveDisplayName}}" width="40" height="40" class="avatar">
                        </a>
                        <div class="stream-topic-meta">
                          <div class="stream-topic-title-line">
                            <a href="/forum/t/{{.TopicID}}#post-{{.PostNumber}}" class="stream-topic-title">{{.TopicTitle}}</a>
                            <span class="stream-likes"><span class="d-icon-heart">&#10084;</span> {{.Likes}}</span>
                          </div>
                          <div class="stream-category-line">
                            <a class="badge-category__wrapper" href="/forum/c/{{.CategorySlug}}">
                              <span class="badge-category-bg" style="background-color: {{.CategoryColor}}"></span>
                              <span class="badge-category__name">{{.CategoryName}}</span>
                            </a>
                          </div>
                        </div>
                        <div class="stream-time-meta">
                          <span class="time">{{.RelativeStr}}</span>
                        </div>
                      </div>
                      <div class="excerpt">
                        {{range .Paragraphs}}<p>{{.}}</p>{{end}}
                      </div>
                    </div>
                    {{end}}
                  </div>
                  {{else}}
                  <div class="d-empty-stream">
                    <p>No liked posts recorded yet.</p>
                  </div>
                  {{end}}

                  {{else if eq .ActivitySub "solved"}}
                  <!-- SUB-TAB: SOLVED / ACCEPTED SOLUTIONS -->
                  <div class="d-stream-header">
                    <h3 class="stats-title" style="margin:0">Accepted Solutions ({{.SolvedCount}})</h3>
                  </div>
                  {{if .SolvedPosts}}
                  <div class="user-stream">
                    {{range .SolvedPosts}}
                    <div class="user-stream-item item">
                      <div class="user-stream-item-header">
                        <span class="d-solved-check" title="Accepted Solution">&#10004;</span>
                        <div class="stream-topic-meta">
                          <div class="stream-topic-title-line">
                            <a href="/forum/t/{{.TopicID}}#post-{{.PostNumber}}" class="stream-topic-title">{{.TopicTitle}}</a>
                            <span class="stream-post-badge d-solved-pill">Solution #{{.PostNumber}}</span>
                          </div>
                          <div class="stream-category-line">
                            <a class="badge-category__wrapper" href="/forum/c/{{.CategorySlug}}">
                              <span class="badge-category-bg" style="background-color: {{.CategoryColor}}"></span>
                              <span class="badge-category__name">{{.CategoryName}}</span>
                            </a>
                          </div>
                        </div>
                        <div class="stream-time-meta">
                          <span class="time">{{.RelativeStr}}</span>
                        </div>
                      </div>
                      <div class="excerpt">
                        {{range .Paragraphs}}<p>{{.}}</p>{{end}}
                      </div>
                    </div>
                    {{end}}
                  </div>
                  {{else}}
                  <div class="d-empty-stream">
                    <p>No accepted solutions recorded yet.</p>
                  </div>
                  {{end}}

                  {{else if eq .ActivitySub "votes"}}
                  <!-- SUB-TAB: VOTES & SERVER BOOSTS -->
                  <div class="d-stream-header">
                    <h3 class="stats-title" style="margin:0">Server Boosts &amp; Topic Votes ({{.UpvoteCount}})</h3>
                    <a href="/servers" class="d-btn d-btn-primary d-btn-theme d-btn-xs">Browse Server List</a>
                  </div>
                  <div class="user-stream">
                    <div class="user-stream-item item">
                      <div class="user-stream-item-header">
                        <img src="{{.Profile.AvatarPath}}" alt="{{.Profile.EffectiveDisplayName}}" width="40" height="40" class="avatar">
                        <div class="stream-topic-meta">
                          <div class="stream-topic-title-line">
                            <strong>Active NSM Server Boost Power: {{.UpvoteCount}} BOOST&trade;</strong>
                          </div>
                          <div class="stream-category-line">
                            <span class="d-muted">{{if .Profile.FavoriteServer}}Assigned to: {{.Profile.FavoriteServer}}{{else}}Ready to boost any live server on the NSM Masterlist{{end}}</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  {{else}}
                  <!-- SUB-TAB: ALL ACTIVITY STREAM (Default 1:1 Discourse .user-stream) -->
                  <div class="d-stream-header">
                    <h3 class="stats-title" style="margin:0">All Activity by {{.Profile.EffectiveDisplayName}} ({{len .Posts}})</h3>
                    <a href="/forum" class="d-btn d-btn-primary d-btn-theme d-btn-xs">+ New Topic</a>
                  </div>
                  {{if .Posts}}
                  <div class="user-stream">
                    {{range .Posts}}
                    <div class="user-stream-item item">
                      <div class="user-stream-item-header">
                        <a href="/u/{{$.Profile.Username}}" class="stream-avatar-link">
                          <img src="{{$.Profile.AvatarPath}}" alt="{{$.Profile.EffectiveDisplayName}}" width="40" height="40" class="avatar">
                        </a>
                        <div class="stream-topic-meta">
                          <div class="stream-topic-title-line">
                            <a href="/forum/t/{{.TopicID}}#post-{{.PostNumber}}" class="stream-topic-title">{{.TopicTitle}}</a>
                            <span class="stream-post-badge">{{if .IsReply}}Reply #{{.PostNumber}}{{else}}Created Topic{{end}}</span>
                          </div>
                          <div class="stream-category-line">
                            <a class="badge-category__wrapper" href="/forum/c/{{.CategorySlug}}">
                              <span class="badge-category-bg" style="background-color: {{.CategoryColor}}"></span>
                              <span class="badge-category__name">{{.CategoryName}}</span>
                            </a>
                            {{range .Tags}}<span class="discourse-tag box">{{.}}</span>{{end}}
                          </div>
                        </div>
                        <div class="stream-time-meta">
                          <span class="time" title="{{.CreatedAt}}">{{.RelativeStr}}</span>
                          {{if gt .Likes 0}}<span class="stream-likes"><span class="d-icon-heart">&#10084;</span> {{.Likes}}</span>{{end}}
                        </div>
                      </div>
                      <div class="excerpt">
                        {{range .Paragraphs}}<p>{{.}}</p>{{end}}
                      </div>
                    </div>
                    {{end}}
                  </div>
                  {{else}}
                  <div class="d-empty-stream">
                    <p>No activity recorded for <strong>{{.Profile.EffectiveDisplayName}}</strong> yet.</p>
                    <a href="/forum" class="d-btn d-btn-primary d-btn-theme">Post on AFX Forum</a>
                  </div>
                  {{end}}
                  {{end}}

                </div>
              </div>

              {{else if eq .Tab "notifications"}}
              <!-- ==============================================================
                   TAB: NOTIFICATIONS (1:1 Discourse user/notifications)
                   ============================================================== -->
              <div class="d-activity-layout">
                <div class="user-navigation user-secondary-navigation">
                  <nav class="user-nav-secondary">
                    <ul class="action-list nav-stacked">
                      <li><a href="/u/{{.Profile.Username}}?tab=notifications" class="active"><span>All Notifications</span><span class="d-subnav-count">{{len .Notifications}}</span></a></li>
                      <li><a href="/u/{{.Profile.Username}}?tab=likes"><span>Likes Received</span><span class="d-subnav-count">{{.LikesReceived}}</span></a></li>
                      <li><a href="/u/{{.Profile.Username}}?tab=badges"><span>Badges Earned</span><span class="d-subnav-count">{{len .Badges}}</span></a></li>
                    </ul>
                  </nav>
                </div>

                <div class="user-content-stream">
                  <div class="d-stream-header">
                    <h3 class="stats-title" style="margin:0">Notifications for {{.Profile.EffectiveDisplayName}}</h3>
                  </div>
                  <div class="user-stream">
                    {{range .Notifications}}
                    <a href="{{.URL}}" class="user-stream-item d-notification-item {{if .Unread}}unread{{end}}">
                      <div class="user-stream-item-header">
                        <span class="d-notif-icon d-notif-{{.Kind}}">
                          {{if eq .Kind "liked"}}&#10084;{{else if eq .Kind "badge"}}&#9733;{{else if eq .Kind "replied"}}&#8617;{{else}}&#9889;{{end}}
                        </span>
                        <div class="stream-topic-meta">
                          <div class="stream-topic-title-line">
                            <strong>{{.Title}}</strong>
                          </div>
                          <div class="stream-category-line">
                            <span class="d-muted">{{.Excerpt}}</span>
                          </div>
                        </div>
                        <div class="stream-time-meta">
                          <span class="time">{{.RelativeStr}}</span>
                        </div>
                      </div>
                    </a>
                    {{end}}
                  </div>
                </div>
              </div>

              {{else if eq .Tab "messages"}}
              <!-- ==============================================================
                   TAB: PERSONAL MESSAGES (1:1 Discourse user/messages)
                   ============================================================== -->
              <div class="d-activity-layout">
                <div class="user-navigation user-secondary-navigation">
                  <nav class="user-nav-secondary">
                    <ul class="action-list nav-stacked">
                      <li><a href="/u/{{.Profile.Username}}?tab=messages" class="active"><span>Inbox</span><span class="d-subnav-count">{{len .Messages}}</span></a></li>
                      <li><a href="/forum"><span>New Message / Topic</span></a></li>
                    </ul>
                  </nav>
                </div>

                <div class="user-content-stream">
                  <div class="d-stream-header">
                    <h3 class="stats-title" style="margin:0">Personal Messages ({{len .Messages}})</h3>
                    <a href="/forum" class="d-btn d-btn-primary d-btn-theme d-btn-xs">+ New Message</a>
                  </div>
                  <div class="user-stream">
                    {{range .Messages}}
                    <a href="{{.URL}}" class="user-stream-item d-message-item">
                      <div class="user-stream-item-header">
                        <img src="{{.SenderAvatar}}" alt="{{.Sender}}" width="42" height="42" class="avatar">
                        <div class="stream-topic-meta">
                          <div class="stream-topic-title-line">
                            <span class="stream-topic-title">{{.Title}}</span>
                            <span class="stream-post-badge">From @{{.Sender}}</span>
                          </div>
                          <div class="stream-category-line">
                            <span class="d-muted">{{.Excerpt}}</span>
                          </div>
                        </div>
                        <div class="stream-time-meta">
                          <span class="time">{{.RelativeStr}}</span>
                        </div>
                      </div>
                    </a>
                    {{end}}
                  </div>
                </div>
              </div>

              {{else if eq .Tab "badges"}}
              <!-- ==============================================================
                   TAB: USER BADGES
                   ============================================================== -->
              <div class="top-section badges-section">
                <h3 class="stats-title">Badges Earned by {{.Profile.EffectiveDisplayName}} (@{{.Profile.Username}}) ({{len .Badges}})</h3>
                <div class="badge-group-list">
                  {{range .Badges}}
                  <div class="d-badge-card">
                    <div class="d-badge-icon" style="color: {{.Color}}">
                      <svg viewBox="0 0 24 24" fill="currentColor" style="width:28px;height:28px"><circle cx="12" cy="8" r="6"/><path d="M9 14l-2 8 5-3 5 3-2-8"/></svg>
                    </div>
                    <div class="d-badge-info">
                      <h3>{{.Name}}</h3>
                      <p>{{.Desc}}</p>
                      <span class="d-badge-granted">Granted {{$.JoinedStr}}</span>
                    </div>
                  </div>
                  {{end}}
                </div>
              </div>

              {{else}}
              <!-- ==============================================================
                   TAB: SUMMARY (1:1 discourse/app/templates/user/summary.gjs)
                   ============================================================== -->
              <!-- 1. Stats Section (.top-section.stats-section) -->
              <div class="top-section stats-section">
                <h3 class="stats-title">Stats</h3>
                <ul>
                  <li class="stats-days-visited">
                    <div class="user-stat">
                      <span class="value">{{.DaysVisited}}</span>
                      <span class="label">days visited</span>
                    </div>
                  </li>
                  <li class="stats-time-read">
                    <div class="user-stat">
                      <span class="value">{{.ReadTime}}</span>
                      <span class="label">read time</span>
                    </div>
                  </li>
                  <li class="stats-recent-read">
                    <div class="user-stat">
                      <span class="value">{{.RecentReadTime}}</span>
                      <span class="label">recent read time</span>
                    </div>
                  </li>
                  <li class="stats-topics-entered">
                    <a href="/u/{{.Profile.Username}}?tab=read">
                      <div class="user-stat">
                        <span class="value">{{.TopicsViewed}}</span>
                        <span class="label">topics viewed</span>
                      </div>
                    </a>
                  </li>
                  <li class="stats-posts-read">
                    <a href="/u/{{.Profile.Username}}?tab=read">
                      <div class="user-stat">
                        <span class="value">{{.PostsRead}}</span>
                        <span class="label">posts read</span>
                      </div>
                    </a>
                  </li>
                  <li class="stats-likes-given">
                    <a href="/u/{{.Profile.Username}}?tab=likes">
                      <div class="user-stat">
                        <span class="value"><span class="d-icon-heart">&#10084;</span> {{.LikesGiven}}</span>
                        <span class="label">given</span>
                      </div>
                    </a>
                  </li>
                  <li class="stats-likes-received">
                    <a href="/u/{{.Profile.Username}}?tab=likes">
                      <div class="user-stat">
                        <span class="value"><span class="d-icon-heart">&#10084;</span> {{.LikesReceived}}</span>
                        <span class="label">received</span>
                      </div>
                    </a>
                  </li>
                  <li class="stats-topic-count">
                    <a href="/u/{{.Profile.Username}}?tab=topics">
                      <div class="user-stat">
                        <span class="value">{{.TopicCount}}</span>
                        <span class="label">topics created</span>
                      </div>
                    </a>
                  </li>
                  <li class="stats-post-count">
                    <a href="/u/{{.Profile.Username}}?tab=activity">
                      <div class="user-stat">
                        <span class="value">{{.PostCount}}</span>
                        <span class="label">posts created</span>
                      </div>
                    </a>
                  </li>
                  <li class="stats-server-boosts">
                    <a href="/u/{{.Profile.Username}}?tab=votes">
                      <div class="user-stat">
                        <span class="value">{{.UpvoteCount}}</span>
                        <span class="label">server boosts</span>
                      </div>
                    </a>
                  </li>
                </ul>
              </div>

              <!-- 2. Top Replies & Top Topics (.top-section.replies-and-topics-section) -->
              <div class="top-section replies-and-topics-section">
                <div class="top-sub-section replies-section pull-left">
                  <h3 class="stats-title">Top Replies</h3>
                  {{if .Posts}}
                  <ul>
                    {{range .Posts}}
                    <li>
                      <span class="topic-info">
                        {{.CreatedAt}}
                        {{if gt .Likes 0}}&middot; <span class="d-icon-heart">&#10084;</span> {{.Likes}}{{end}}
                      </span>
                      <br>
                      <a href="/forum/t/{{.TopicID}}#post-{{.PostNumber}}">{{.TopicTitle}}</a>
                      {{if .Excerpt}}<div class="d-muted" style="font-size:13px;margin-top:4px">{{.Excerpt}}</div>{{end}}
                    </li>
                    {{end}}
                  </ul>
                  <p style="margin-top:10px"><a href="/u/{{.Profile.Username}}?tab=replies" class="d-more-link">More Replies &rarr;</a></p>
                  {{else}}
                  <p class="d-muted">No replies yet.</p>
                  {{end}}
                </div>

                <div class="top-sub-section topics-section pull-right">
                  <h3 class="stats-title">Top Topics</h3>
                  {{if .Topics}}
                  <ul>
                    {{range .Topics}}
                    <li>
                      <span class="topic-info">
                        {{.Views}} views &middot; {{len .Posts}} posts
                      </span>
                      <br>
                      <a href="/forum/t/{{.ID}}">{{.Title}}</a>
                    </li>
                    {{end}}
                  </ul>
                  <p style="margin-top:10px"><a href="/u/{{.Profile.Username}}?tab=topics" class="d-more-link">More Topics &rarr;</a></p>
                  {{else}}
                  <p class="d-muted">No topics yet.</p>
                  {{end}}
                </div>
              </div>

              <!-- 3. Top Categories & Connected Profiles (.top-section.top-categories-section) -->
              <div class="top-section top-categories-section">
                <div class="top-sub-section summary-category-list pull-left">
                  <h3 class="stats-title">Top Categories</h3>
                  <table>
                    <thead>
                      <tr>
                        <th class="category-link">Category</th>
                        <th class="topic-count">Topics</th>
                        <th class="reply-count">Replies</th>
                      </tr>
                    </thead>
                    <tbody>
                      {{range .TopCategories}}
                      <tr>
                        <td class="category-link">
                          <a class="badge-category__wrapper" href="/forum/c/{{.Slug}}">
                            <span class="badge-category-bg" style="background-color: {{.Color}}"></span>
                            <span class="badge-category__name">{{.Name}}</span>
                          </a>
                        </td>
                        <td class="topic-count"><a href="/u/{{$.Profile.Username}}?tab=topics">{{if gt .TopicCount 0}}{{.TopicCount}}{{else}}&ndash;{{end}}</a></td>
                        <td class="reply-count"><a href="/u/{{$.Profile.Username}}?tab=replies">{{if gt .ReplyCount 0}}{{.ReplyCount}}{{else}}&ndash;{{end}}</a></td>
                      </tr>
                      {{end}}
                    </tbody>
                  </table>
                </div>

                <div class="top-sub-section summary-user-list pull-right">
                  <h3 class="stats-title">Connected Accounts &amp; Most Liked By</h3>
                  <ul>
                    {{if .Profile.DiscordTag}}
                    <li>
                      <span class="topic-info">Discord</span><br>
                      <strong>{{.Profile.DiscordTag}}</strong>
                    </li>
                    {{end}}
                    {{if .Profile.GitHub}}
                    <li>
                      <span class="topic-info">GitHub</span><br>
                      <a href="{{.Profile.GitHubURL}}" rel="noopener">github.com/{{.Profile.GitHubHandle}}</a>
                    </li>
                    {{end}}
                    {{if .Profile.Steam}}
                    <li>
                      <span class="topic-info">Steam</span><br>
                      <a href="{{.Profile.SteamURL}}" rel="noopener">{{.Profile.Steam}}</a>
                    </li>
                    {{end}}
                    <li class="d-summary-user-row">
                      <img src="/avatars/u/Cravenz/48.png" alt="Cravenz" width="36" height="36" class="avatar">
                      <div>
                        <a href="/u/Cravenz"><strong>Cravenz</strong> <span class="d-muted">NSM Founder</span></a>
                        <div class="d-muted"><span class="d-icon-heart">&#10084;</span> {{.LikesReceived}}</div>
                      </div>
                    </li>
                  </ul>
                </div>
              </div>

              <!-- 4. Top Badges (.top-section.badges-section) -->
              <div class="top-section badges-section">
                <h3 class="stats-title">Top Badges</h3>
                <div class="badge-group-list">
                  {{range .Badges}}
                  <div class="d-badge-card">
                    <div class="d-badge-icon" style="color: {{.Color}}">
                      <svg viewBox="0 0 24 24" fill="currentColor" style="width:24px;height:24px"><circle cx="12" cy="8" r="6"/><path d="M9 14l-2 8 5-3 5 3-2-8"/></svg>
                    </div>
                    <div class="d-badge-info">
                      <h3>{{.Name}}</h3>
                      <p>{{.Desc}}</p>
                    </div>
                  </div>
                  {{end}}
                </div>
                <p style="margin-top:12px"><a href="/u/{{.Profile.Username}}?tab=badges" class="d-more-link">View All Badges ({{len .Badges}}) &rarr;</a></p>
              </div>
              {{end}}

            </div>
          </div>
        </section>
      </div>
    </main>
  </div>

  <script>
    function hexToRgbTriplet(hex) {
      if (!hex || hex.length !== 7 || hex[0] !== '#') return '47, 123, 255';
      var r = parseInt(hex.slice(1, 3), 16);
      var g = parseInt(hex.slice(3, 5), 16);
      var b = parseInt(hex.slice(5, 7), 16);
      if (isNaN(r) || isNaN(g) || isNaN(b)) return '47, 123, 255';
      return r + ', ' + g + ', ' + b;
    }
    function syncNsmLiveColors() {
      var root = document.getElementById('nsm-user-profile-root');
      if (!root) return;
      var p = document.getElementById('picker-theme-primary');
      var a = document.getElementById('picker-theme-accent');
      var b = document.getElementById('picker-banner-color');
      var v = document.getElementById('picker-avatar-color');
      if (p) {
        root.style.setProperty('--prof-primary', p.value);
        root.style.setProperty('--prof-primary-rgb', hexToRgbTriplet(p.value));
        var hp = document.getElementById('hex-theme-primary');
        if (hp) hp.textContent = p.value;
      }
      if (a) {
        root.style.setProperty('--prof-accent', a.value);
        root.style.setProperty('--prof-accent-rgb', hexToRgbTriplet(a.value));
        var ha = document.getElementById('hex-theme-accent');
        if (ha) ha.textContent = a.value;
      }
      if (b) {
        root.style.setProperty('--prof-banner', b.value);
        var hb = document.getElementById('hex-banner-color');
        if (hb) hb.textContent = b.value;
      }
      if (v) {
        root.style.setProperty('--prof-avatar', v.value);
        var hv = document.getElementById('hex-avatar-color');
        if (hv) hv.textContent = v.value;
      }
    }
    function applyNsmProfileTheme(primary, accent, banner, avatar) {
      var p = document.getElementById('picker-theme-primary');
      var a = document.getElementById('picker-theme-accent');
      var b = document.getElementById('picker-banner-color');
      var v = document.getElementById('picker-avatar-color');
      if (p) p.value = primary;
      if (a) a.value = accent;
      if (b) b.value = banner;
      if (v) v.value = avatar;
      syncNsmLiveColors();
    }
    if (window.location.pathname === '/account/profile' && window.history && window.history.replaceState) {
      window.history.replaceState(null, '', '/u/{{.Profile.Username}}?tab={{.Tab}}');
    }
  </script>
  <script src="/js/main.js?v=078h"></script>
</body>
</html>
