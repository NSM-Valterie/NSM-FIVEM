{{template "head" .}}

<!-- 1:1 Hero Section + NSM.exe Continuity Tiles -->
<section class="nsm-hero">
  <div class="wrap nsm-hero-grid">
    <div class="nsm-hero-left">
      <div style="display:inline-flex;align-items:center;gap:10px;padding:6px 14px;border-radius:999px;background:rgba(22,25,35,0.78);border:1px solid rgba(47,123,255,0.35);margin-bottom:18px">
        <img src="/img/nsm-icon.png" alt="NSM" style="width:20px;height:20px">
        <span style="font-size:0.8rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#a8c7ff">NSM Client &bull; Powered by AFX</span>
      </div>

      <h1 class="nsm-hero-title">
        <span>NSM</span> is the GTA V multiplayer modification you have dreamt of
      </h1>
      <p class="nsm-hero-lead">
        NSM is a modification for Grand Theft Auto V enabling you to play multiplayer on customized dedicated servers, powered by the AFX framework.
      </p>

      <div class="nsm-download-wrap">
        <a href="/servers" target="_blank" rel="noopener" class="nsm-download-btn">
          <img src="/img/nsm-icon.png" alt="NSM" style="width:36px;height:36px;flex-shrink:0">
          <span>
            Launch NSM Client
            <small>NSM.exe &bull; Browse Live Servers in New Tab</small>
          </span>
        </a>
        <div class="nsm-terms-note">
          Need a server license key? Open <a href="/keymaster" target="_blank" rel="noopener">AFX Portal</a> or read the <a href="/docs" target="_blank" rel="noopener">NSM Documentation</a>.
        </div>
      </div>

      <!-- NSM.exe HomePage Continuity Grid (Play / Favorites / History / Localhost) -->
      <div class="mp-continuity-grid">
        <a href="/servers" target="_blank" rel="noopener" class="mp-cont-tile mp-cont-play">
          <div class="mp-cont-play-icon">
            <img src="/img/nsm-icon.png" alt="Play" style="width:42px;height:42px">
          </div>
          <div>
            <div class="mp-cont-play-title">PLAY NSM</div>
            <div class="mp-cont-play-sub"><span data-stat="servers">{{index .Stats "Servers"}}</span> live servers &bull; <span data-stat="players">{{index .Stats "Players"}}</span> players online</div>
          </div>
        </a>
        <a href="/servers#favorites" target="_blank" rel="noopener" class="mp-cont-tile mp-cont-fav">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="width:20px;height:20px;color:#f40552"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <span>FAVORITES</span>
        </a>
        <a href="/servers#history" target="_blank" rel="noopener" class="mp-cont-tile mp-cont-hist">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="width:20px;height:20px;color:#2096f3"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>HISTORY</span>
        </a>
        <button type="button" class="mp-cont-tile mp-cont-local" data-connect-ep="127.0.0.1:30120">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="width:18px;height:18px;color:#00f8b9"><rect x="2" y="3" width="20" height="7" rx="1.5"/><rect x="2" y="14" width="20" height="7" rx="1.5"/></svg>
          <span>CONNECT LOCALHOST (127.0.0.1:30120)</span>
        </button>
      </div>

      <div class="nsm-hero-links">
        <a href="/servers" target="_blank" rel="noopener" class="nsm-pill-link">
          <span class="dot"></span>
          <span><strong data-stat="players">{{index .Stats "Players"}}</strong> Players Online Across <strong data-stat="servers">{{index .Stats "Servers"}}</strong> Servers</span>
        </a>
        <a href="/keymaster" target="_blank" rel="noopener" class="nsm-pill-link">
          <img src="/img/afx-icon.png" alt="AFX" style="width:15px;height:15px;border-radius:3px">
          <span>AFX Portal &amp; Keymaster</span>
        </a>
        <a href="/user-api-key/new" class="nsm-pill-link">
          <img src="/img/nsm-icon.png" alt="NSM" style="width:15px;height:15px">
          <span>Link NSM.exe Account</span>
        </a>
      </div>
    </div>

    <div class="nsm-hero-right">
      <div class="nsm-video-card">
        <img src="/img/hero-bg.jpg" alt="NSM Gameplay">
        <div class="nsm-video-overlay">
          <a href="/servers" target="_blank" rel="noopener" class="nsm-play-badge">
            <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            Browse Live NSM Servers
          </a>
        </div>
      </div>

      <div class="nsm-promo-card">
        <img src="/img/enhanced-art.jpg" alt="NSM Dedicated Servers">
        <div class="nsm-promo-body">
          <h3>Host Your Own Dedicated Server on NSM</h3>
          <p>Issue a server key in <a href="/keymaster" target="_blank" rel="noopener" style="color:#00f8b9">AFX Portal</a> and launch <code>nsm-server.exe</code> with instant masterlist listing.</p>
        </div>
        <a href="/keymaster" target="_blank" rel="noopener" class="btn btn-primary btn-sm">Open AFX Portal</a>
      </div>
    </div>
  </div>
</section>

<!-- 6 Official NSM & AFX Standalone Web Portals (Each Opens in a Separate Tab) -->
<section class="afx-suite-section">
  <div class="wrap">
    <div class="afx-suite-header">
      <div>
        <span class="afx-eyebrow"><img src="/img/afx-icon.png" alt="AFX" style="width:14px;height:14px;border-radius:3px"> AFX &amp; NSM ECOSYSTEM</span>
        <h2>Explore the Complete NSM &amp; AFX Platform Suite</h2>
        <p>Every platform service opens in its own dedicated tab with its full layout, live database, and unified AFX account session.</p>
      </div>
    </div>

    <div class="afx-suite-grid">
      <!-- 1. Server List - NSM -->
      <a href="/servers" target="_blank" rel="noopener" class="afx-suite-card">
        <div class="afx-suite-top">
          <img src="/img/nsm-icon.png" alt="NSM" class="afx-suite-logo">
          <span class="afx-suite-tab-pill">servers.nsm &nearr;</span>
        </div>
        <h3>Server List - NSM</h3>
        <p>1:1 NSM.exe live server browser with tag &amp; locale facets, Boost power sorting, Favorites, History, and instant in-game connect.</p>
        <div class="afx-suite-foot">
          <span><strong data-stat="servers">{{index .Stats "Servers"}}</strong> Live Servers</span>
          <span class="afx-suite-cta">Open Server List &rarr;</span>
        </div>
      </a>

      <!-- 2. Login - AFX Portal -->
      <a href="/keymaster" target="_blank" rel="noopener" class="afx-suite-card">
        <div class="afx-suite-top">
          <img src="/img/afx-icon.png" alt="AFX Portal" class="afx-suite-logo">
          <span class="afx-suite-tab-pill">portal.afx &nearr;</span>
        </div>
        <h3>Login - AFX Portal</h3>
        <p>Manage your NSM server license keys (<code>nsm_srv_...</code>), rotate credentials, bind server endpoints, and manage granted assets.</p>
        <div class="afx-suite-foot">
          <span>Keymaster &amp; Assets</span>
          <span class="afx-suite-cta">Open AFX Portal &rarr;</span>
        </div>
      </a>

      <!-- 3. AFX Support -->
      <a href="/support" target="_blank" rel="noopener" class="afx-suite-card">
        <div class="afx-suite-top">
          <img src="/img/afx-icon.png" alt="AFX Support" class="afx-suite-logo">
          <span class="afx-suite-tab-pill">support.afx &nearr;</span>
        </div>
        <h3>AFX Support</h3>
        <p>Search knowledge-base articles, client &amp; server troubleshooting guides, live platform status, and submit support tickets.</p>
        <div class="afx-suite-foot">
          <span>Help Center &amp; Tickets</span>
          <span class="afx-suite-cta">Open AFX Support &rarr;</span>
        </div>
      </a>

      <!-- 4. AFX Forum - The home of NSM -->
      <a href="/forum" target="_blank" rel="noopener" class="afx-suite-card">
        <div class="afx-suite-top">
          <img src="/img/nsm-icon.png" alt="AFX Forum" class="afx-suite-logo">
          <span class="afx-suite-tab-pill">forum.afx &nearr;</span>
        </div>
        <h3>AFX Forum - The home of NSM</h3>
        <p>Join the NSM community forum: official announcements, server development, scripts, Server Bazaar, and technical support.</p>
        <div class="afx-suite-foot">
          <span><strong>{{index .Stats "Posts"}}</strong> Community Posts</span>
          <span class="afx-suite-cta">Open AFX Forum &rarr;</span>
        </div>
      </a>

      <!-- 5. AFX Marketplace -->
      <a href="/marketplace" target="_blank" rel="noopener" class="afx-suite-card">
        <div class="afx-suite-top">
          <img src="/img/afx-icon.png" alt="AFX Marketplace" class="afx-suite-logo">
          <span class="afx-suite-tab-pill">marketplace.afx &nearr;</span>
        </div>
        <h3>AFX Marketplace</h3>
        <p>Discover verified NSM scripts, custom MLOs, vehicles, EUP packs, UI frameworks, and ready-to-run server bases.</p>
        <div class="afx-suite-foot">
          <span>Verified NSM Resources</span>
          <span class="afx-suite-cta">Open Marketplace &rarr;</span>
