{{template "head" .}}

<!-- 1:1 fivem.net Hero Section (.bg-holder.with-bg + section.hero + #dl) -->
<div class="bg-holder with-bg">
  <section class="hero">
    <div class="text">
      <div class="subtitle">The GTA V multiplayer modification you have dreamt of</div>
      <h1 class="title">Welcome to Los Santos.</h1>
      <p class="lead">
        NSM is a modification for Grand Theft Auto V enabling you to play multiplayer on customized dedicated servers, powered by the Cfx.re framework. Build roleplay worlds, stream custom vehicles and maps, and manage your servers with NSM Keymaster.
      </p>

      <div class="hero-cta-row">
        <a id="dl" href="/docs#client-setup">
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download Client &mdash; NSM.exe
          </span>
          <sub>NSM.exe &bull; Windows 10 / 11 (64-bit) &bull; Terms of Service</sub>
        </a>

        <a href="/servers" class="btn btn-ghost btn-lg">Browse Live Servers</a>
        <a href="/keymaster" class="btn btn-ghost btn-lg">Server Keymaster</a>
        <a href="/forum" class="btn btn-ghost btn-lg">Community Forum</a>
      </div>

      <div class="hero-live-pill">
        <span class="pulse-dot"></span>
        <span>
          <strong data-stat="players">{{index .Stats "Players"}}</strong> players online right now across
          <strong data-stat="servers">{{index .Stats "Servers"}}</strong> live servers &bull;
          <strong>{{index .Stats "Accounts"}}</strong> accounts &bull;
          <strong>{{index .Stats "Posts"}}</strong> forum posts
        </span>
      </div>
    </div>
  </section>
</div>

<!-- 1:1 fivem.net Overlapping Features Grid (.features + article.a1..a4) -->
<section class="features">
  <h1>What we have for you</h1>
  <div class="features-grid">
    <article class="a1">
      <h2>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        Streaming
      </h2>
      <p>
        Custom cars, maps, weapons, clothes, and MLO interiors stream seamlessly on connect. NSM caches server assets locally so joining your favorite servers is fast and effortless.
      </p>
    </article>

    <article class="a2">
      <h2>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        AI &amp; Population
      </h2>
      <p>
        Keep the original Grand Theft Auto V AI traffic and pedestrians synced across players, or script custom server-authoritative NPCs and missions with OneSync Infinity.
      </p>
    </article>

    <article class="a3">
      <h2>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        Sync quality
      </h2>
      <p>
        Uses the original GTA V network code enhanced by Cfx.re OneSync, supporting up to 2048 concurrent players per server with accurate vehicle, weapon, and animation sync.
      </p>
    </article>

    <article class="a4">
      <h2>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Standalone
      </h2>
      <p>
        NSM never modifies your base Grand Theft Auto V installation files. Switch between GTA:Online and NSM at any time without ever risking a Rockstar ban.
      </p>
    </article>
  </div>
</section>

<!-- Live NSM.exe Server Browser Embedded Directly on the Homepage -->
<section class="nsm-launcher-section">
  <div class="nsm-launcher-header">
    <div>
      <h2>
        <span>Live NSM.exe Server Browser</span>
        <span class="nsm-live-badge"><span class="pulse-dot" style="width:7px;height:7px"></span> Shared with NSM.exe</span>
      </h2>
      <p class="muted" style="margin:4px 0 0;font-size:0.9rem">
        The exact same live server list displayed inside the <code>NSM.exe</code> desktop launcher &mdash; click any row to inspect or connect
      </p>
    </div>
    <div style="display:flex;gap:8px">
      <a href="/servers" class="btn btn-ghost btn-sm">Open Fullscreen Server Browser &rarr;</a>
      <a href="/keymaster" class="btn btn-primary btn-sm">Register a Server Key</a>
    </div>
  </div>

  {{template "nsm_server_launcher" .}}
</section>

<!-- 1:1 fivem.net Gold-Framed Enhanced Card (.enhanced) -->
<section class="enhanced">
  <div class="enhanced-card">
    <div class="cleft">
      <span class="badge-enhanced">Enhanced Support</span>
      <h1>Now supporting Grand Theft Auto V Enhanced</h1>
      <p>
        Jump into Los Santos with full support for both classic Grand Theft Auto V and the latest game builds, complete with NSM's integrated Discourse account sign-in, Keymaster server licensing, and real-time protobuf masterlist discovery.
      </p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:0.5rem">
        <a href="/servers" class="btn btn-primary">Explore Live Servers</a>
        <a href="/user-api-key/new" class="btn btn-ghost">Link Account in NSM.exe</a>
      </div>
    </div>
    <div class="cright" aria-hidden="true"></div>
  </div>
</section>

