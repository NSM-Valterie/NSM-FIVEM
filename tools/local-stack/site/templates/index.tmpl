<!-- Embedded 1:1 NSM.exe Server Browser -->
<section class="home-launcher-section">
  <div class="wrap">
    <div class="home-launcher-header">
      <div>
        <span class="nsm-launcher-badge">
          <span class="dot"></span>
          LIVE NSM.EXE SERVER LAUNCHER
        </span>
        <h2 style="margin:6px 0 0;font-size:1.65rem;font-weight:700;color:#fff">Browse &amp; Connect to Live NSM Servers</h2>
      </div>
      <div style="display:flex;gap:10px;align-items:center">
        <a href="/keymaster" target="_blank" rel="noopener" class="nsm-ctrl-btn">Issue Server Key</a>
        <a href="/servers" target="_blank" rel="noopener" class="nsm-btn nsm-btn-primary">Open Fullscreen Server List Tab &nearr;</a>
      </div>
    </div>

    <div class="home-embedded-mp">
      {{template "nsm_server_launcher" .}}
    </div>
  </div>
</section>

<!-- 1:1 Feature Blocks -->
<section class="nsm-features-section">
  <div class="wrap">
    <div class="nsm-features-grid">
      <article class="nsm-feature-card a1">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
        </div>
        <div class="desc">
          <h2>Streaming</h2>
          <p>NSM allows servers to use custom cars, maps, weapons, and clothes dynamically — streamed directly from your server to connected players with zero manual client file edits.</p>
        </div>
      </article>

      <article class="nsm-feature-card a2">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div class="desc">
          <h2>NPCs &amp; World Sync</h2>
          <p>NSM servers keep ambient world population, traffic, and synced entities active so your multiplayer world never feels empty. Build co-op missions, roleplay cities, or racing circuits.</p>
        </div>
      </article>

      <article class="nsm-feature-card a3">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        </div>
        <div class="desc">
          <h2>Sync Quality</h2>
          <p>NSM uses the original game network code augmented with OneSync state bags and high-frequency entity replication, delivering rock-solid synchronization up to 2048 players.</p>
        </div>
      </article>

      <article class="nsm-feature-card a4">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div class="desc">
          <h2>Standalone</h2>
          <p>NSM does not touch your base Grand Theft Auto V installation files, so you can switch between singleplayer and NSM servers at any time without corrupting your game directory.</p>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- Community Forum Highlights -->
<section class="wrap" style="padding:16px 24px 48px">
  <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:20px;flex-wrap:wrap;gap:12px">
    <div>
      <h2 style="margin:0;font-size:1.5rem;font-weight:600;color:#fff">Latest on the AFX Community Forum</h2>
      <p style="margin:4px 0 0;color:rgba(240,244,248,0.62);font-size:0.92rem">Announcements, resource releases, and server guides from the NSM community</p>
    </div>
    <a href="/forum" target="_blank" rel="noopener" class="nsm-ctrl-btn">Open AFX Forum in New Tab &nearr;</a>
  </div>

  <div class="discourse-table-wrap">
    <table class="discourse-topic-table">
      <thead>
        <tr>
          <th>Topic</th>
          <th>Posters</th>
          <th class="num">Replies</th>
          <th class="num">Views</th>
          <th class="num">Activity</th>
        </tr>
      </thead>
      <tbody>
        {{range .ForumTopics}}
        <tr>
          <td>
            <a href="/forum/t/{{.ID}}" target="_blank" rel="noopener" class="topic-title-link">
              {{if .Pinned}}<span style="color:#f40552;margin-right:4px" title="Pinned">&#128204;</span>{{end}}
              {{.Title}}
            </a>
            <div class="topic-meta-row">
              <span class="cat-badge" style="color:{{.Category.Color}}">
                <span class="cat-dot" style="background:{{.Category.Color}}"></span>
                {{.Category.Name}}
              </span>
              {{range .Tags}}
              <span class="tag-pill">{{.}}</span>
              {{end}}
            </div>
          </td>
          <td>
            <div class="poster-avatars">
              {{range .Posters}}
              <a href="/u/{{.Username}}" title="{{.DisplayName}} (@{{.Username}})">
                <img src="{{.Avatar}}" alt="{{.Username}}">
              </a>
              {{end}}
            </div>
          </td>
          <td class="num">{{.Replies}}</td>
          <td class="num">{{.Views}}</td>
          <td class="num" style="font-size:0.82rem">{{.UpdatedAtStr}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
</section>

<!-- FAQ Section -->
<section class="nsm-faq-section">
  <div class="wrap">
    <div style="text-align:center;margin-bottom:32px">
      <h2 style="font-size:1.85rem;font-weight:600;color:#fff;margin:0 0 8px">Frequently Asked Questions</h2>
      <p style="color:rgba(240,244,248,0.62);margin:0">Everything you need to know about playing and hosting on NSM &amp; AFX</p>
    </div>

    <div class="nsm-faq-list">
      <div class="nsm-faq-item open">
        <button type="button" class="nsm-faq-q">
          <span>Will I get banned from GTA:O for playing NSM?</span>
          <span>+</span>
        </button>
        <div class="nsm-faq-a">
          Nope! NSM does not interact with Rockstar Online Services other than to validate your game copy the first time you launch it. It never modifies your base Grand Theft Auto V installation files.
        </div>
      </div>

      <div class="nsm-faq-item">
        <button type="button" class="nsm-faq-q">
          <span>How do I sign in to my account inside NSM.exe?</span>
          <span>+</span>
        </button>
        <div class="nsm-faq-a">
          Click <strong>Sign In / Link Account</strong> in the top-right corner of <code>NSM.exe</code>. If you are already signed in on this website, your account links automatically in one click! You can also authorize via <a href="/user-api-key/new" style="color:#00f8b9">/user-api-key/new</a> or customize your profile at <a href="/account" style="color:#00f8b9">/account</a>.
        </div>
      </div>

      <div class="nsm-faq-item">
        <button type="button" class="nsm-faq-q">
          <span>How do I register a Server Key in AFX Portal?</span>
          <span>+</span>
        </button>
        <div class="nsm-faq-a">
          Sign in on <a href="/keymaster" target="_blank" rel="noopener" style="color:#00f8b9">AFX Portal</a>, enter your server name and optional IP:port, and click <strong>Generate Server Key</strong>. Copy the generated <code>sets sv_nsmServerKey "nsm_srv_..."</code> line into your <code>server.cfg</code> or <code>server-local.cfg</code>.
        </div>
      </div>
    </div>
  </div>
</section>

{{template "foot" .}}
