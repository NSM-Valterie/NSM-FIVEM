{{template "head" .}}
<section class="features">
  <div class="container"><div class="spacer">
    <h1>Staff, Partner &amp; User Management</h1>
    <p class="lead">Assign roles and grant the official <strong>Partnered Server Owner</strong> badge: <strong>user</strong>, <strong>partner</strong> (Partnered Server Owner), <strong>staff</strong> (can grant Partner &amp; moderate), <strong>admin</strong>, <strong>owner</strong>.</p>
    <div class="fx">
      {{range .Users}}
      <div class="c-lg-4 c-md-6 c-xs-12">
        <article class="a1">
          <h2>{{.EffectiveDisplayName}} <span class="muted">(@{{.Username}} &middot; #{{.ID}})</span></h2>
          <span class="txt">
            Role: <strong>{{.Role}}</strong>
            {{if .HasPartnerBadge}} &middot; <strong style="color:#a855f7">Partnered</strong>{{end}}
            {{if .HasPulse}} &middot; <strong style="color:#ec4899">{{.EffectivePulseTierLabel}}</strong>{{end}}
          </span>
          <form method="POST" action="/admin/users/{{.ID}}/role" class="btnpadder" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
            <select name="role" style="width:auto;display:inline-block">
              <option value="user" {{if eq .Role "user"}}selected{{end}}>user</option>
              <option value="partner" {{if eq .Role "partner"}}selected{{end}}>partner</option>
              <option value="staff" {{if eq .Role "staff"}}selected{{end}}>staff</option>
              <option value="admin" {{if eq .Role "admin"}}selected{{end}}>admin</option>
              <option value="owner" {{if eq .Role "owner"}}selected{{end}}>owner</option>
            </select>
            <button class="btn btn-accent" style="width:auto;display:inline-block">SET ROLE</button>
          </form>
          <form method="POST" action="/admin/users/{{.ID}}/partner" style="margin-top:8px">
            <input type="hidden" name="return_to" value="/admin/users">
            <button class="btn" style="width:100%">{{if .IsPartner}}Revoke Partner Badge{{else}}Grant Partner Role &amp; Badge{{end}}</button>
          </form>
        </article>
      </div>
      {{end}}
    </div>
  </div></div>
</section>
{{template "foot" .}}
