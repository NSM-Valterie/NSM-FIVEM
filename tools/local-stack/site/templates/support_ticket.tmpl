{{template "head" .}}
<div class="zd-support-shell" style="padding-top:1.5rem;padding-bottom:4rem">
  <main class="zd-container" style="max-width:1280px;margin:0 auto;padding:0 1.5rem">
    <!-- Breadcrumbs -->
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:1.5rem;font-size:0.86rem;color:#94a3b8">
      <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
        <a href="/support" style="color:#60a5fa;text-decoration:none;font-weight:600">AFX Support Center</a>
        <span>›</span>
        <a href="/support" style="color:#cbd5e1;text-decoration:none">Requests</a>
        <span>›</span>
        <span style="color:#fff;font-weight:700">Request #{{.Ticket.ID}}</span>
      </div>
      <div style="display:flex;align-items:center;gap:8px">
        {{if .IsStaff}}
        <a class="btn ghost sm" href="/admin/users">🛡️ Staff Panel Queue</a>
        {{end}}
        <a class="btn ghost sm" href="/support#submit-ticket">+ Submit Another Request</a>
      </div>
    </div>

    {{if .Msg}}
    <div style="margin-bottom:1.25rem;padding:12px 16px;border-radius:10px;background:rgba(16,185,129,0.16);border:1px solid rgba(16,185,129,0.45);color:#a7f3d0;font-weight:600">
      ✓ {{.Msg}}
    </div>
    {{end}}
    {{if .Error}}
    <div style="margin-bottom:1.25rem;padding:12px 16px;border-radius:10px;background:rgba(239,68,68,0.16);border:1px solid rgba(239,68,68,0.45);color:#fecaca;font-weight:600">
      ⚠️ {{.Error}}
    </div>
    {{end}}

    <!-- Two-Column Zendesk Request Layout -->
    <div style="display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:28px;align-items:start">
      <!-- Left Column: Subject, Conversation Thread & Reply Box -->
      <div style="display:flex;flex-direction:column;gap:18px">
        <div class="fcard" style="padding:1.75rem">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:8px">
            <span style="font-family:var(--mono);font-size:0.82rem;font-weight:700;padding:3px 10px;border-radius:6px;background:rgba(47,123,255,0.18);color:#60a5fa">
              REQUEST #{{.Ticket.ID}}
            </span>
            <span style="padding:3px 10px;border-radius:999px;font-size:0.76rem;font-weight:700;{{if eq .Ticket.Status "Open"}}background:rgba(245,158,11,0.18);color:#fcd34d{{else if eq .Ticket.Status "Answered"}}background:rgba(56,189,248,0.18);color:#7dd3fc{{else}}background:rgba(16,185,129,0.18);color:#6ee7b7{{end}}">
              {{.Ticket.Status}}
            </span>
            <span class="muted" style="font-size:0.82rem">{{.Ticket.Category}}</span>
          </div>
          <h1 style="margin:0;font-size:1.65rem;font-weight:800;color:#fff;line-height:1.3">{{.Ticket.Subject}}</h1>
        </div>

        <!-- Messages Thread -->
        {{range .Ticket.Messages}}
        <div class="fcard" style="padding:1.5rem;{{if .IsStaff}}border:1px solid rgba(56,189,248,0.45);background:linear-gradient(145deg,rgba(15,23,42,0.95),rgba(14,116,144,0.12)){{end}}">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding-bottom:12px;margin-bottom:14px;border-bottom:1px solid rgba(255,255,255,0.08);flex-wrap:wrap">
            <a href="/u/{{.AuthorUsername}}" style="display:inline-flex;align-items:center;gap:12px;text-decoration:none;color:#fff">
              <img src="{{.AuthorAvatar}}" alt="{{.AuthorUsername}}" style="width:42px;height:42px;border-radius:50%;object-fit:cover;border:2px solid {{if .IsStaff}}#38bdf8{{else}}#2F7BFF{{end}}">
              <div>
                <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                  <strong style="font-size:0.98rem">{{.AuthorDisplay}}</strong>
                  <span class="muted" style="font-size:0.84rem">@{{.AuthorUsername}}</span>
                  {{if .IsStaff}}
                  <span style="padding:2px 8px;border-radius:999px;background:rgba(56,189,248,0.2);border:1px solid rgba(56,189,248,0.5);color:#7dd3fc;font-size:0.7rem;font-weight:800;text-transform:uppercase;letter-spacing:0.05em">
                    🛡️ {{.RoleLabel}}
                  </span>
                  {{else}}
                  <span style="padding:2px 8px;border-radius:999px;background:rgba(255,255,255,0.07);color:#cbd5e1;font-size:0.7rem;font-weight:600">
                    Requester
                  </span>
                  {{end}}
                </div>
                <div class="muted" style="font-size:0.78rem;margin-top:2px">{{.CreatedStr}} ({{.RelativeStr}})</div>
              </div>
            </a>
          </div>
          <div style="font-size:0.95rem;line-height:1.65;color:#e2e8f0;white-space:pre-wrap">{{.Body}}</div>
        </div>
        {{end}}

        <!-- Reply Form (Available to Requester & Staff/Admins/Owners) -->
        <div class="fcard" style="padding:1.75rem">
          {{if .User}}
            {{if .CanReply}}
              <h3 style="margin:0 0 0.4rem;font-size:1.15rem">
                {{if .IsStaff}}🛡️ Post Official AFX Staff / Owner Reply{{else}}Add a Reply to Your Request{{end}}
              </h3>
              <p class="muted" style="margin:0 0 1rem;font-size:0.86rem">
                Replying as <strong>{{.User.EffectiveDisplayName}} (@{{.User.Username}})</strong>
              </p>
              <form method="post" action="/support/requests/{{.Ticket.ID}}/reply">
                <textarea name="body" class="finput" rows="5" required placeholder="{{if .IsStaff}}Write an official staff response to help resolve this request...{{else}}Add additional information or reply to AFX Support...{{end}}" style="margin-bottom:12px"></textarea>
                <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
                  {{if .IsStaff}}
                  <div style="display:flex;align-items:center;gap:8px">
                    <label class="muted" style="font-size:0.84rem;font-weight:600">Set Ticket Status:</label>
                    <select name="status" class="finput" style="width:auto;margin:0;padding:0.4rem 0.75rem">
                      <option value="Answered" {{if eq .Ticket.Status "Answered"}}selected{{end}}>Answered</option>
                      <option value="Open" {{if eq .Ticket.Status "Open"}}selected{{end}}>Open</option>
                      <option value="Solved" {{if eq .Ticket.Status "Solved"}}selected{{end}}>Solved</option>
                      <option value="Closed" {{if eq .Ticket.Status "Closed"}}selected{{end}}>Closed</option>
                    </select>
                  </div>
                  {{else}}
                  <div></div>
                  {{end}}
                  <button type="submit" class="btn primary">Submit Reply</button>
                </div>
              </form>
            {{else}}
              <p class="muted" style="margin:0">Only the requester (@{{.Ticket.RequesterUsername}}) or AFX Support Staff can reply to this ticket.</p>
            {{end}}
          {{else}}
            <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
              <span class="muted">Sign in to post a follow-up reply to this support request.</span>
              <a class="btn primary sm" href="/login?next=/support/requests/{{.Ticket.ID}}">Sign In to Reply</a>
            </div>
          {{end}}
        </div>
      </div>

      <!-- Right Sidebar: Zendesk Request Metadata Inspector -->
      <aside class="fcard" style="padding:1.5rem;position:sticky;top:90px">
        <h3 style="margin:0 0 1rem;font-size:0.95rem;text-transform:uppercase;letter-spacing:0.06em;color:#94a3b8;border-bottom:1px solid rgba(255,255,255,0.08);padding-bottom:10px">
          Request Details
        </h3>
        <div style="display:flex;flex-direction:column;gap:14px;font-size:0.88rem">
          <div>
            <div class="muted" style="font-size:0.76rem;text-transform:uppercase;letter-spacing:0.05em">Requester</div>
            <div style="font-weight:700;color:#fff;margin-top:2px">
              <a href="/u/{{.Ticket.RequesterUsername}}" style="color:#60a5fa;text-decoration:none">{{.Ticket.RequesterDisplay}} (@{{.Ticket.RequesterUsername}})</a>
            </div>
          </div>
          <div>
            <div class="muted" style="font-size:0.76rem;text-transform:uppercase;letter-spacing:0.05em">Requester Email</div>
            <div style="font-weight:600;color:#e2e8f0;margin-top:2px;word-break:break-all">{{.Ticket.RequesterEmail}}</div>
          </div>
          <div>
            <div class="muted" style="font-size:0.76rem;text-transform:uppercase;letter-spacing:0.05em">Ticket ID</div>
            <div style="font-family:var(--mono);font-weight:700;color:#fff;margin-top:2px">#{{.Ticket.ID}}</div>
          </div>
          <div>
            <div class="muted" style="font-size:0.76rem;text-transform:uppercase;letter-spacing:0.05em">Status</div>
            <div style="margin-top:4px">
              <span style="padding:3px 10px;border-radius:999px;font-size:0.76rem;font-weight:700;{{if eq .Ticket.Status "Open"}}background:rgba(245,158,11,0.18);color:#fcd34d{{else if eq .Ticket.Status "Answered"}}background:rgba(56,189,248,0.18);color:#7dd3fc{{else}}background:rgba(16,185,129,0.18);color:#6ee7b7{{end}}">
                {{.Ticket.Status}}
              </span>
            </div>
          </div>
          <div>
            <div class="muted" style="font-size:0.76rem;text-transform:uppercase;letter-spacing:0.05em">Category</div>
            <div style="color:#e2e8f0;margin-top:2px">{{.Ticket.Category}}</div>
          </div>
          <div>
            <div class="muted" style="font-size:0.76rem;text-transform:uppercase;letter-spacing:0.05em">Priority</div>
            <div style="color:#e2e8f0;margin-top:2px;font-weight:600">{{.Ticket.Priority}}</div>
          </div>
          {{if .Ticket.ServerEndpoint}}
          <div>
            <div class="muted" style="font-size:0.76rem;text-transform:uppercase;letter-spacing:0.05em">Server Endpoint</div>
            <div style="font-family:var(--mono);color:#5eead4;margin-top:2px">{{.Ticket.ServerEndpoint}}</div>
          </div>
          {{end}}
          <div>
            <div class="muted" style="font-size:0.76rem;text-transform:uppercase;letter-spacing:0.05em">Created</div>
            <div style="color:#cbd5e1;margin-top:2px">{{.Ticket.CreatedStr}}</div>
          </div>
          <div>
            <div class="muted" style="font-size:0.76rem;text-transform:uppercase;letter-spacing:0.05em">Last Activity</div>
            <div style="color:#cbd5e1;margin-top:2px">{{.Ticket.UpdatedStr}}</div>
          </div>
        </div>

        {{if .IsStaff}}
        <form method="post" action="/support/requests/{{.Ticket.ID}}/status" style="margin-top:1.25rem;padding-top:1rem;border-top:1px solid rgba(255,255,255,0.08)">
          <label class="muted" style="display:block;font-size:0.76rem;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:6px">Staff Quick Status</label>
          <div style="display:flex;gap:6px">
            <select name="status" class="finput" style="margin:0;padding:0.35rem 0.6rem;font-size:0.82rem;flex:1">
              <option value="Open" {{if eq .Ticket.Status "Open"}}selected{{end}}>Open</option>
              <option value="Answered" {{if eq .Ticket.Status "Answered"}}selected{{end}}>Answered</option>
              <option value="Solved" {{if eq .Ticket.Status "Solved"}}selected{{end}}>Solved</option>
              <option value="Closed" {{if eq .Ticket.Status "Closed"}}selected{{end}}>Closed</option>
            </select>
            <button class="btn sm primary" type="submit">Update</button>
          </div>
        </form>
        {{end}}
      </aside>
    </div>
  </main>
</div>
{{template "foot" .}}
