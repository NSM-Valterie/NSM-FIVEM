{{template "head" .}}

<section class="wrap section">
  <p style="margin-bottom:12px"><a href="/servers" class="muted">&larr; Back to Server List</a></p>
  <div class="srv-detail">
    <div class="srv-detail-head">
      <div>
        <h1>{{.CleanName}}</h1>
        <div class="srv-sub" style="margin-top:8px">
          {{if .Srv.Gametype}}<span class="tag">{{.Srv.Gametype}}</span>{{end}}
          {{if .Srv.Mapname}}<span class="tag">{{.Srv.Mapname}}</span>{{end}}
          <span class="tag"><code>{{.EndPoint}}</code></span>
          {{if .OwnerUsername}}
          <a href="/u/{{.OwnerUsername}}" class="tag" style="color:var(--acc);border-color:rgba(249,115,22,.35)">Verified Owner: @{{.OwnerUsername}}</a>
          {{end}}
        </div>
      </div>
      <div class="srv-detail-cta">
        <div class="srv-big-count"><b>{{.Srv.Clients}}</b><span>/{{.Srv.SVMaxclients}} players</span></div>
        <form method="post" action="/servers/{{.EndPoint}}/upvote" style="display:inline">
          <button class="btn {{if .Voted}}btn-voted{{else}}btn-ghost{{end}}" type="submit">
            &#9650; {{.Upvotes}} {{if .Voted}}Boosted{{else}}Boost Server{{end}}
          </button>
        </form>
        <button type="button" class="btn btn-ghost" onclick="navigator.clipboard.writeText('connect {{.EndPoint}}');this.textContent='Copied F8 Connect!'">Copy F8 Connect</button>
        <a href="nsm://connect/{{.EndPoint}}" class="btn btn-primary btn-lg">Connect in NSM</a>
      </div>
    </div>

    {{with index .Srv.Vars "sv_projectDesc"}}
    <p class="lead" style="margin-top:16px">{{.}}</p>
    {{end}}

    <div class="detail-cols">
      <div class="detail-box">
        <h3>Connected Players ({{len .Srv.Players}})</h3>
        {{if .Srv.Players}}
        <ul class="plist">
          {{range .Srv.Players}}
          <li><span>{{.Name}}</span><span class="muted">{{.Ping}} ms</span></li>
          {{end}}
        </ul>
        {{else}}
        <p class="muted">No players currently in this server.</p>
        {{end}}
      </div>

      <div class="detail-box">
        <h3>Loaded Resources ({{len .Srv.Resources}})</h3>
        <div class="tags">
          {{range .Srv.Resources}}<span class="tag">{{.}}</span>{{end}}
        </div>
      </div>
    </div>
  </div>
</section>

{{template "foot" .}}
