{{template "head" .}}

<section class="wrap section auth-wrap">
  <div class="auth-card">
    <h1>Create your NSM account</h1>
    <p class="muted">One account for the NSM client, server upvotes, custom profiles, Keymaster, and forum.</p>
    {{if .Error}}<div class="alert alert-err" style="margin-bottom:12px">{{.Error}}</div>{{end}}
    <form method="post" action="/register" class="form">
      <input type="hidden" name="next" value="{{.Next}}">
      <label>Username (3–24 characters)
        <input type="text" name="username" class="inp" required minlength="3" maxlength="24" autofocus>
      </label>
      <label>Email (optional)
        <input type="email" name="email" class="inp">
      </label>
      <label>Password (6+ characters)
        <input type="password" name="password" class="inp" required minlength="6">
      </label>
      <button type="submit" class="btn btn-primary btn-block">Create account</button>
    </form>
    <p class="auth-foot">Already have an account? <a href="/login{{if .Next}}?next={{.Next}}{{end}}">Sign in</a></p>
  </div>
</section>

{{template "foot" .}}
