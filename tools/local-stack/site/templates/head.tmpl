{{define "head"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{if .Title}}{{.Title}} — {{end}}NSM — FiveM / Cfx.re Local Platform</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
{{if .HasPendingClientAuth}}
<div class="client-auth-banner">
  <div class="wrap client-auth-banner-inner">
    <span><strong>NSM Client Sign-In Requested:</strong> Your NSM desktop app is waiting to link your account.</span>
    <a href="/user-api-key/new" class="btn btn-primary btn-xs">Authorize NSM App &rarr;</a>
  </div>
</div>
{{end}}
<header class="topbar">
  <div class="wrap topbar-in">
    <a href="/" class="brand">
      <span class="brand-mark">NSM</span>
      <span class="brand-sub">Platform <small>v0.7.8</small></span>
    </a>
    <nav class="nav">
      <a href="/" {{if eq .Page "/"}}class="on"{{end}}>Home</a>
      <a href="/servers" {{if eq .Page "/servers"}}class="on"{{end}}>Servers {{if .Stats}}<span class="nav-count">{{index .Stats "Servers"}}</span>{{end}}</a>
      <a href="/forum" {{if eq .Page "/forum"}}class="on"{{end}}>Forum</a>
      <a href="/keymaster" {{if eq .Page "/keymaster"}}class="on"{{end}}>Keymaster</a>
      <a href="/docs" {{if eq .Page "/docs"}}class="on"{{end}}>Docs</a>
      <a href="/support" {{if eq .Page "/support"}}class="on"{{end}}>Support</a>
      {{if .User}}{{if or (eq .User.Role "staff") (eq .User.Role "admin") (eq .User.Role "owner")}}
      <a href="/admin/users" {{if eq .Page "/admin/users"}}class="on"{{end}}>Staff</a>
      {{end}}{{end}}
    </nav>
    <div class="auth">
      {{if .Stats}}
      <a href="/servers" class="live-pill" title="Live players and servers on NSM Masterlist">
        <span class="dot"></span>
        <span><b id="nav-players">{{index .Stats "Players"}}</b> playing</span>
      </a>
      {{end}}
      {{if .User}}
        <a href="/u/{{.User.Username}}" class="user-chip" title="View public profile">
          <img src="{{.User.AvatarPath}}" alt="{{.User.Username}}" class="nav-avatar">
          <span class="user-chip-name">{{.User.EffectiveDisplayName}}</span>
          <span class="role role-{{.User.Role}}">{{.User.Role}}</span>
        </a>
        <a href="/account" class="btn btn-ghost btn-sm">Profile &amp; Settings</a>
        <a href="/logout" class="btn btn-ghost btn-sm">Log out</a>
      {{else}}
        <a href="/login" class="btn btn-ghost btn-sm">Sign in</a>
        <a href="/register" class="btn btn-primary btn-sm">Create account</a>
      {{end}}
    </div>
  </div>
</header>
<main class="main">
{{end}}
