{{template "head" .}}
<div class="zd-support-shell">
  <!-- Zendesk-style Help Center Subheader (support.cfx.re/hc/en-us) -->
  <section class="zd-hero">
    <div class="zd-hero-inner">
      <div class="zd-hero-badge">AFX Official Help Center</div>
      <h1 class="zd-hero-title">How can we help you today?</h1>
      <form class="zd-search-box" action="/forum" method="get">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="search" name="q" placeholder="Search support articles, error codes, or topics..." autocomplete="off">
        <button type="submit" class="btn primary sm">Search</button>
      </form>
      <div class="zd-quick-pills">
        <span>Popular:</span>
        <a href="/docs#quick-start">Connecting to a Server</a>
        <a href="/keymaster">Generating a Server Key</a>
        <a href="#submit-ticket">Submit a Support Request</a>
        <a href="/forum/c/support">Technical Support Forum</a>
      </div>
    </div>
  </section>

  <!-- Main Category Blocks (1:1 support.cfx.re layout) -->
  <main class="zd-container">
    {{if .Error}}
    <div style="margin-bottom:1.5rem;padding:12px 18px;border-radius:10px;background:rgba(239,68,68,0.16);border:1px solid rgba(239,68,68,0.45);color:#fecaca;font-weight:600">
      ⚠️ {{.Error}}
    </div>
    {{end}}
    {{if .Msg}}
    <div style="margin-bottom:1.5rem;padding:12px 18px;border-radius:10px;background:rgba(16,185,129,0.16);border:1px solid rgba(16,185,129,0.45);color:#a7f3d0;font-weight:600">
      ✓ {{.Msg}}
    </div>
    {{end}}

    <!-- Active Support Requests Table (if user has tickets or is staff) -->
    {{if .Tickets}}
    <section class="zd-ticket-section" style="margin-bottom:2rem">
      <div class="zd-ticket-card">
        <div class="zd-ticket-head" style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
          <div>
            <h2 style="margin:0">{{if and .User .User.IsStaffOrHigher}}All Community Support Requests (Staff Queue){{else}}My Support Requests{{end}}</h2>
            <p style="margin:4px 0 0">Click any request below to view details, status, and replies from AFX Support Staff.</p>
          </div>
          <a class="btn primary sm" href="#submit-ticket">+ Submit a Request</a>
        </div>
        <div style="overflow-x:auto;margin-top:1rem">
          <table style="width:100%;border-collapse:collapse">
            <thead>
              <tr style="text-align:left;border-bottom:1px solid rgba(255,255,255,0.1);color:#94a3b8;font-size:0.76rem;text-transform:uppercase;letter-spacing:0.06em">
                <th style="padding:10px 12px">ID</th>
                <th style="padding:10px 12px">Subject</th>
                <th style="padding:10px 12px">Requester Email</th>
                <th style="padding:10px 12px">Category</th>
                <th style="padding:10px 12px">Last Activity</th>
                <th style="padding:10px 12px">Status</th>
              </tr>
            </thead>
            <tbody>
              {{range .Tickets}}
              <tr style="border-bottom:1px solid rgba(255,255,255,0.06)">
                <td style="padding:12px;font-family:var(--mono);color:#60a5fa;font-weight:700">#{{.ID}}</td>
                <td style="padding:12px">
                  <a href="/support/requests/{{.ID}}" style="color:#fff;font-weight:700;text-decoration:none">{{.Subject}}</a>
                </td>
                <td style="padding:12px;font-size:0.86rem;color:#cbd5e1">{{.RequesterEmail}}</td>
                <td style="padding:12px;font-size:0.84rem;color:#94a3b8">{{.Category}}</td>
                <td style="padding:12px;font-size:0.84rem;color:#94a3b8">{{.UpdatedStr}}</td>
                <td style="padding:12px">
                  <a href="/support/requests/{{.ID}}" style="text-decoration:none;padding:3px 10px;border-radius:999px;font-size:0.75rem;font-weight:700;{{if eq .Status "Open"}}background:rgba(245,158,11,0.18);color:#fcd34d{{else if eq .Status "Answered"}}background:rgba(56,189,248,0.18);color:#7dd3fc{{else}}background:rgba(16,185,129,0.18);color:#6ee7b7{{end}}">
                    {{.Status}} &rarr;
                  </a>
                </td>
              </tr>
              {{end}}
            </tbody>
          </table>
        </div>
      </div>
    </section>
    {{end}}

    <section class="zd-blocks-grid">
      <a href="/docs" class="zd-block-card">
        <div class="zd-block-icon">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        </div>
        <h3>NSM Client Support</h3>
        <p>Installation, Rockstar game cache verification, Direct Connect, and in-app AFX account linking.</p>
      </a>

      <a href="/keymaster" class="zd-block-card">
        <div class="zd-block-icon">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
        </div>
        <h3>AFX Portal &amp; Server Keys</h3>
        <p>Issue, manage, and configure <code>sv_nsmServerKey</code> license keys and masterlist heartbeats.</p>
      </a>

      <a href="/account" class="zd-block-card">
        <div class="zd-block-icon">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <h3>Account, Email &amp; 2FA</h3>
        <p>Verify your email address, configure Two-Step Verification (2FA), and customize your AFX profile.</p>
      </a>

      <a href="#submit-ticket" class="zd-block-card">
        <div class="zd-block-icon">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </div>
        <h3>Submit a Report / Ticket</h3>
        <p>Submit an official support ticket or report directly to AFX Support Staff and track replies on your request page.</p>
      </a>
    </section>

    <!-- Submit a Support Request Form (1:1 Zendesk Request Form -> redirects to /support/requests/{id}) -->
    <section class="zd-ticket-section" id="submit-ticket">
      <div class="zd-ticket-card">
        <div class="zd-ticket-head">
          <h2>Submit a request</h2>
          <p>Submit a report or support request below. After clicking <strong>Submit Report</strong>, you will be taken directly to your dedicated Request Page showing your email, subject, ticket status, and replies from AFX Staff &amp; Owners.</p>
        </div>
        <form class="zd-ticket-form" action="/support/requests" method="post">
          <div class="zd-form-row" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px">
            <div>
              <label>Your email address <span style="color:#f87171">*</span></label>
              <input type="email" name="email" class="finput" required value="{{if .User}}{{.User.Email}}{{end}}" placeholder="you@example.com">
            </div>
            <div>
              <label>What can we help you with? <span style="color:#f87171">*</span></label>
              <select name="category" class="finput">
                <option value="Client & Technical Support">NSM Client &amp; Technical Support</option>
                <option value="Report a Player / Server">Report a Player or Server Violation</option>
                <option value="AFX Portal & Server Keys">AFX Portal &amp; Server License Keys</option>
                <option value="Account, Email & 2FA">Account, Email Verification &amp; Two-Step (2FA)</option>
                <option value="Bug Report">Platform Bug Report</option>
              </select>
            </div>
          </div>
          <div class="zd-form-row">
            <label>Subject <span style="color:#f87171">*</span></label>
            <input type="text" name="subject" class="finput" required placeholder="Brief summary of your report or issue...">
          </div>
          <div class="zd-form-row" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px">
            <div>
              <label>Priority</label>
              <select name="priority" class="finput">
                <option value="Normal">Normal</option>
                <option value="High">High</option>
                <option value="Urgent">Urgent</option>
              </select>
            </div>
            <div>
              <label>Server Endpoint / Connect Code (optional)</label>
              <input type="text" name="endpoint" class="finput" placeholder="e.g. 127.0.0.1:30120">
            </div>
          </div>
          <div class="zd-form-row">
            <label>Description <span style="color:#f87171">*</span></label>
            <textarea name="body" class="finput" rows="6" required placeholder="Please enter the details of your request, steps to reproduce, or evidence. A member of our AFX Support Staff will respond as soon as possible."></textarea>
          </div>
          <div class="zd-form-actions" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
            <button type="submit" class="btn primary">Submit Report</button>
            <a href="{{.Invite}}" class="btn ghost">Join Support Discord</a>
          </div>
        </form>
      </div>
    </section>
  </main>
</div>
{{template "foot" .}}
