{{template "head" .}}

<section class="wrap section">
  <div class="sec-head">
    <div>
      <h1>Support &amp; Platform Status</h1>
      <p class="muted">Live system status, troubleshooting guides, and community support channels</p>
    </div>
    <a href="/forum/c/support" class="btn btn-primary btn-sm">Ask in Technical Support Forum &rarr;</a>
  </div>

  <div class="stats-grid" style="margin-bottom:24px">
    <div class="stat">
      <div class="stat-num" style="color:var(--ok);font-size:20px">&#10003; ONLINE</div>
      <div class="stat-lbl">Masterlist &amp; Ingress</div>
    </div>
    <div class="stat">
      <div class="stat-num" style="color:var(--ok);font-size:20px">&#10003; ONLINE</div>
      <div class="stat-lbl">Keymaster Service</div>
    </div>
    <div class="stat">
      <div class="stat-num" style="color:var(--ok);font-size:20px">&#10003; ONLINE</div>
      <div class="stat-lbl">In-App Client Auth</div>
    </div>
    <div class="stat">
      <div class="stat-num" style="color:var(--ok);font-size:20px">&#10003; ONLINE</div>
      <div class="stat-lbl">Forum &amp; Profiles</div>
    </div>
  </div>

  <div class="detail-cols">
    <div class="detail-box">
      <h3>Common Questions &amp; Fixes</h3>
      <div style="display:flex;flex-direction:column;gap:14px;margin-top:12px">
        <div>
          <strong>How do I sign in inside the NSM app?</strong>
          <p class="muted" style="margin-top:4px">Click <strong>Link Account</strong> inside the NSM app (or open <a href="/user-api-key/new">/user-api-key/new</a> in your browser), sign in with your NSM account, and click <strong>Authorize &amp; Sign In to NSM Client</strong>. The NSM client will automatically log you in within 1 second.</p>
        </div>
        <div>
          <strong>How do I list my server on the Server List?</strong>
          <p class="muted" style="margin-top:4px">Open <a href="/keymaster">Keymaster</a>, generate a server key, paste <code>sets sv_nsmServerKey "nsm_srv_..."</code> into your <code>server-local.cfg</code>, and start <code>nsm-server.exe</code>.</p>
        </div>
        <div>
          <strong>How do I change my profile picture &amp; bio?</strong>
          <p class="muted" style="margin-top:4px">Sign in and open <a href="/account">Profile &amp; Settings</a> to upload a custom avatar image, pick your banner color, and edit your display name and bio.</p>
        </div>
      </div>
    </div>

    <div class="detail-box">
      <h3>Support Channels</h3>
      <p class="muted" style="margin:8px 0 16px">Get help from the NSM community or browse developer documentation:</p>
      <div style="display:flex;flex-direction:column;gap:10px">
        <a href="/forum/c/support" class="btn btn-primary">Open Technical Support Forum</a>
        <a href="/docs" class="btn btn-ghost">Read Platform Documentation</a>
        <a href="/keymaster" class="btn btn-ghost">Open Keymaster Portal</a>
        <a href="{{.Invite}}" target="_blank" rel="noopener" class="btn btn-ghost">Join Community Discord &rarr;</a>
      </div>
    </div>
  </div>
</section>

{{template "foot" .}}
